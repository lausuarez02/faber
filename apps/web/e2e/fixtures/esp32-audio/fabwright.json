    { "id": "w3", "from": { "part": "amp", "pin": "BCLK" }, "to": { "part": "xiao", "pin": "GPIO2" }, "color": "#F2E14A" },
    { "id": "w4", "from": { "part": "amp", "pin": "LRC" }, "to": { "part": "xiao", "pin": "GPIO3" }, "color": "#B47CFF" },
