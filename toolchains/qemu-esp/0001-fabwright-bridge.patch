diff --git a/hw/gpio/esp32_gpio.c b/hw/gpio/esp32_gpio.c
index 4fea1f5..880b935 100644
--- a/hw/gpio/esp32_gpio.c
+++ b/hw/gpio/esp32_gpio.c
@@ -18,27 +18,300 @@
 #include "hw/irq.h"
 #include "hw/qdev-properties.h"
 #include "hw/gpio/esp32_gpio.h"
+#include "chardev/char-fe.h"
+#include "qemu/timer.h"
+#include "hw/qdev-properties-system.h"
 
 
 
+/*
+ * Fabwright bridge. When the "bridge" chardev property is set, GPIO and I2C activity is mirrored
+ * to Fabwright as text lines (one per event), and Fabwright drives inputs the same way.
+ *
+ * QEMU -> Fabwright
+ *   G <out0> <out1> <en0> <en1> <ns>   output/enable state changed (hex masks, virtual ns)
+ *   IS <addr> <r|w> <ns>               I2C start; Fabwright answers "A 0" (ACK) or "A 1" (NACK)
+ *   IW <addr> <byte>                   I2C byte written by the chip (no answer)
+ *   IR <addr>                          I2C byte read by the chip; Fabwright answers "D <byte>"
+ *   IP <addr>                          I2C stop (no answer)
+ *   U <ns> <hex bytes>                 bytes UART0 transmitted
+ *   T <ns>                             lockstep only: reached the target, waiting for "R"
+ * Fabwright -> QEMU
+ *   I <pin> <0|1>                      drive an input pin
+ *   W <hex bytes>                      bytes into UART0 RX
+ *   R <ns>                             lockstep only: run until virtual time <ns> (needs -icount)
+ *   A <0|1> / D <hex>                  answers, only while QEMU waits for them
+ * All numbers are hex without 0x except <pin> and levels (decimal).
+ */
+static Esp32GpioState *fabwright_bridge_gpio;
+static void *fabwright_uart;
+static int (*fabwright_uart_can_rx)(void *opaque);
+static void (*fabwright_uart_rx)(void *opaque, const uint8_t *buf, int size);
+
+void fabwright_bridge_offer_uart(void *uart, int (*can_rx)(void *opaque),
+                              void (*rx)(void *opaque, const uint8_t *buf, int size))
+{
+    if (!fabwright_uart) {
+        fabwright_uart = uart;
+        fabwright_uart_can_rx = can_rx;
+        fabwright_uart_rx = rx;
+    }
+}
+
+static bool fabwright_bridge_active_(void);
+bool fabwright_bridge_owns_uart(void *uart)
+{
+    return uart == fabwright_uart && fabwright_bridge_active_();
+}
+
+bool fabwright_bridge_active(void)
+{
+    return fabwright_bridge_active_();
+}
+
+static bool fabwright_bridge_active_(void)
+{
+    return fabwright_bridge_gpio && qemu_chr_fe_backend_connected(&fabwright_bridge_gpio->bridge);
+}
+
+static void fabwright_bridge_printf(Esp32GpioState *s, const char *fmt, ...) G_GNUC_PRINTF(2, 3);
+static void fabwright_bridge_printf(Esp32GpioState *s, const char *fmt, ...)
+{
+    char buf[700];
+    va_list ap;
+    va_start(ap, fmt);
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    if (n > 0 && qemu_chr_fe_backend_connected(&s->bridge)) {
+        qemu_chr_fe_write_all(&s->bridge, (const uint8_t *)buf, MIN(n, (int)sizeof(buf) - 1));
+    }
+}
+
+void fabwright_bridge_uart_tx(const uint8_t *buf, int n)
+{
+    char hex[2 * 128 + 1];
+    while (n > 0) {
+        int k = MIN(n, 128);
+        for (int i = 0; i < k; i++) {
+            snprintf(hex + 2 * i, 3, "%02x", buf[i]);
+        }
+        fabwright_bridge_printf(fabwright_bridge_gpio, "U %" PRIx64 " %s\n",
+                             (uint64_t)qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), hex);
+        buf += k;
+        n -= k;
+    }
+}
+
+static void fabwright_bridge_uart_rx_hex(const char *hex)
+{
+    uint8_t bytes[256];
+    int n = 0;
+    unsigned v;
+    while (hex[0] && hex[1] && n < (int)sizeof(bytes) && sscanf(hex, "%2x", &v) == 1) {
+        bytes[n++] = v;
+        hex += 2;
+    }
+    /* Feed what the RX FIFO takes; the rest is dropped (as a real UART overrun would). */
+    if (fabwright_uart && n > 0) {
+        int room = fabwright_uart_can_rx(fabwright_uart);
+        if (room > 0) {
+            fabwright_uart_rx(fabwright_uart, bytes, MIN(n, room));
+        }
+    }
+}
+
+static void esp32_gpio_notify(Esp32GpioState *s)
+{
+    fabwright_bridge_printf(s, "G %x %x %x %x %" PRIx64 "\n", s->out[0], s->out[1],
+                         s->enable[0], s->enable[1],
+                         (uint64_t)qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+}
+
+/* Handles one complete line from Fabwright. Returns the answer kind ('A'/'D') with its value. */
+static int fabwright_bridge_line(Esp32GpioState *s, const char *line, uint64_t *value)
+{
+    unsigned a = 0, b = 0;
+    if (line[0] == 'I' && sscanf(line + 1, "%u %u", &a, &b) == 2 && a < 64) {
+        uint32_t bit = 1u << (a & 31);
+        if (b) {
+            s->in_ext[a >> 5] |= bit;
+        } else {
+            s->in_ext[a >> 5] &= ~bit;
+        }
+        return 0;
+    }
+    if (line[0] == 'W' && line[1] == ' ') {
+        fabwright_bridge_uart_rx_hex(line + 2);
+        return 0;
+    }
+    if (line[0] == 'R' && sscanf(line + 1, "%x", &a) == 1) {
+        uint64_t t = 0;
+        sscanf(line + 1, "%" SCNx64, &t);
+        *value = t;
+        return 'R';
+    }
+    if ((line[0] == 'A' || line[0] == 'D') && sscanf(line + 1, "%x", &a) == 1) {
+        *value = a;
+        return line[0];
+    }
+    return 0;
+}
+
+static int fabwright_bridge_feed(Esp32GpioState *s, uint8_t c, uint64_t *value)
+{
+    if (c == '\r') {
+        return 0;
+    }
+    if (c != '\n') {
+        if (s->line_len < (int)sizeof(s->line) - 1) {
+            s->line[s->line_len++] = c;
+        }
+        return 0;
+    }
+    s->line[s->line_len] = 0;
+    s->line_len = 0;
+    return fabwright_bridge_line(s, s->line, value);
+}
+
+static int esp32_gpio_can_receive(void *opaque)
+{
+    return 64;
+}
+
+static void esp32_gpio_receive(void *opaque, const uint8_t *buf, int size)
+{
+    Esp32GpioState *s = opaque;
+    uint64_t v;
+    for (int i = 0; i < size; i++) {
+        fabwright_bridge_feed(s, buf[i], &v);
+    }
+}
+
+/* Blocks the vCPU until Fabwright answers with a line of the wanted kind (inputs are applied on the way). */
+static uint64_t fabwright_bridge_wait(Esp32GpioState *s, int kind, uint64_t fallback)
+{
+    for (;;) {
+        uint8_t c;
+        uint64_t v = 0;
+        if (qemu_chr_fe_read_all(&s->bridge, &c, 1) != 1) {
+            return fallback;
+        }
+        if (fabwright_bridge_feed(s, c, &v) == kind) {
+            return v;
+        }
+    }
+}
+
+int fabwright_bridge_i2c_start(uint8_t addr, bool is_read)
+{
+    Esp32GpioState *s = fabwright_bridge_gpio;
+    if (!fabwright_bridge_active()) {
+        return 1;
+    }
+    fabwright_bridge_printf(s, "IS %x %c %" PRIx64 "\n", addr, is_read ? 'r' : 'w',
+                         (uint64_t)qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    return fabwright_bridge_wait(s, 'A', 1) ? 1 : 0;
+}
+
+void fabwright_bridge_i2c_send(uint8_t addr, uint8_t byte)
+{
+    if (fabwright_bridge_active()) {
+        fabwright_bridge_printf(fabwright_bridge_gpio, "IW %x %x\n", addr, byte);
+    }
+}
+
+uint8_t fabwright_bridge_i2c_recv(uint8_t addr)
+{
+    Esp32GpioState *s = fabwright_bridge_gpio;
+    if (!fabwright_bridge_active()) {
+        return 0xff;
+    }
+    fabwright_bridge_printf(s, "IR %x\n", addr);
+    return fabwright_bridge_wait(s, 'D', 0xff) & 0xff;
+}
+
+void fabwright_bridge_i2c_stop(uint8_t addr)
+{
+    if (fabwright_bridge_active()) {
+        fabwright_bridge_printf(fabwright_bridge_gpio, "IP %x\n", addr);
+    }
+}
+
+/* Lockstep: at each target, report the time and block until Fabwright says how far to run next. */
+static void fabwright_sync_cb(void *opaque)
+{
+    Esp32GpioState *s = opaque;
+    if (!fabwright_bridge_active()) {
+        return;
+    }
+    fabwright_bridge_printf(s, "T %" PRIx64 "\n", (uint64_t)qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    uint64_t target = fabwright_bridge_wait(s, 'R', UINT64_MAX);
+    if (target != UINT64_MAX) {
+        timer_mod(s->sync_timer, target);
+    }
+}
+
+static uint32_t esp32_gpio_in(Esp32GpioState *s, int bank)
+{
+    /* A pin reads back its own output when driven, the external level otherwise. */
+    return (s->out[bank] & s->enable[bank]) | (s->in_ext[bank] & ~s->enable[bank]);
+}
+
 static uint64_t esp32_gpio_read(void *opaque, hwaddr addr, unsigned int size)
 {
     Esp32GpioState *s = ESP32_GPIO(opaque);
-    uint64_t r = 0;
     switch (addr) {
     case A_GPIO_STRAP:
-        r = s->strap_mode;
-        break;
-
+        return s->strap_mode;
+    case A_GPIO_OUT:
+        return s->out[0];
+    case A_GPIO_OUT1:
+        return s->out[1];
+    case A_GPIO_ENABLE:
+        return s->enable[0];
+    case A_GPIO_ENABLE1:
+        return s->enable[1];
+    case A_GPIO_IN:
+        return esp32_gpio_in(s, 0);
+    case A_GPIO_IN1:
+        return esp32_gpio_in(s, 1);
     default:
-        break;
+        return addr < sizeof(s->regs) ? s->regs[addr / 4] : 0;
     }
-    return r;
 }
 
 static void esp32_gpio_write(void *opaque, hwaddr addr,
                        uint64_t value, unsigned int size)
 {
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    uint32_t v = value;
+    uint32_t o0 = s->out[0], o1 = s->out[1], e0 = s->enable[0], e1 = s->enable[1];
+    switch (addr) {
+    case A_GPIO_OUT:          s->out[0] = v; break;
+    case A_GPIO_OUT_W1TS:     s->out[0] |= v; break;
+    case A_GPIO_OUT_W1TC:     s->out[0] &= ~v; break;
+    case A_GPIO_OUT1:         s->out[1] = v; break;
+    case A_GPIO_OUT1_W1TS:    s->out[1] |= v; break;
+    case A_GPIO_OUT1_W1TC:    s->out[1] &= ~v; break;
+    case A_GPIO_ENABLE:       s->enable[0] = v; break;
+    case A_GPIO_ENABLE_W1TS:  s->enable[0] |= v; break;
+    case A_GPIO_ENABLE_W1TC:  s->enable[0] &= ~v; break;
+    case A_GPIO_ENABLE1:      s->enable[1] = v; break;
+    case A_GPIO_ENABLE1_W1TS: s->enable[1] |= v; break;
+    case A_GPIO_ENABLE1_W1TC: s->enable[1] &= ~v; break;
+    case A_GPIO_STRAP:
+    case A_GPIO_IN:
+    case A_GPIO_IN1:
+        break;
+    default:
+        if (addr < sizeof(s->regs)) {
+            s->regs[addr / 4] = v;
+        }
+        break;
+    }
+    if (o0 != s->out[0] || o1 != s->out[1] || e0 != s->enable[0] || e1 != s->enable[1]) {
+        esp32_gpio_notify(s);
+    }
 }
 
