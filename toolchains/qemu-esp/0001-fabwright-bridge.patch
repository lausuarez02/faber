diff --git a/hw/i2c/esp32_i2c.c b/hw/i2c/esp32_i2c.c
index 5f4022f..f0d1fbe 100644
--- a/hw/i2c/esp32_i2c.c
+++ b/hw/i2c/esp32_i2c.c
@@ -281,3 +281,83 @@ static void esp32_i2c_register_types(void)
 }
 
 type_init(esp32_i2c_register_types)
+
+/*
+ * Fabwright I2C bridge: one slave on the ESP32's I2C bus that answers for every address except the
+ * built-in tmp105 (0x48), forwarding each transaction to Fabwright (see hw/gpio/esp32_gpio.c).
+ * Fabwright decides per START whether a part sits at that address (ACK) or not (NACK).
+ */
+#include "hw/gpio/esp32_gpio.h"
+
+#define TYPE_FABWRIGHT_I2C_BRIDGE "fabwright.i2c-bridge"
+OBJECT_DECLARE_SIMPLE_TYPE(FabwrightI2CBridge, FABWRIGHT_I2C_BRIDGE)
+
+struct FabwrightI2CBridge {
+    I2CSlave parent_obj;
+    uint8_t cur_addr;
+};
+
+static bool fabwright_i2c_match(I2CSlave *candidate, uint8_t address, bool broadcast,
+                             I2CNodeList *current_devs)
+{
+    FabwrightI2CBridge *s = FABWRIGHT_I2C_BRIDGE(candidate);
+    if (broadcast || address == 0x48 || !fabwright_bridge_active()) {
+        return false;
+    }
+    s->cur_addr = address;
+    I2CNode *node = g_new(struct I2CNode, 1);
+    node->elt = candidate;
+    QLIST_INSERT_HEAD(current_devs, node, next);
+    return true;
+}
+
+static int fabwright_i2c_event(I2CSlave *i2c, enum i2c_event event)
+{
+    FabwrightI2CBridge *s = FABWRIGHT_I2C_BRIDGE(i2c);
+    switch (event) {
+    case I2C_START_SEND:
+    case I2C_START_SEND_ASYNC:
+        return fabwright_bridge_i2c_start(s->cur_addr, false) ? -1 : 0;
+    case I2C_START_RECV:
+        return fabwright_bridge_i2c_start(s->cur_addr, true) ? -1 : 0;
+    case I2C_FINISH:
+        fabwright_bridge_i2c_stop(s->cur_addr);
+        return 0;
+    default:
+        return 0;
+    }
+}
+
+static int fabwright_i2c_send(I2CSlave *i2c, uint8_t data)
+{
+    fabwright_bridge_i2c_send(FABWRIGHT_I2C_BRIDGE(i2c)->cur_addr, data);
+    return 0;
+}
+
+static uint8_t fabwright_i2c_recv(I2CSlave *i2c)
+{
+    return fabwright_bridge_i2c_recv(FABWRIGHT_I2C_BRIDGE(i2c)->cur_addr);
+}
+
+static void fabwright_i2c_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+    k->match_and_add = fabwright_i2c_match;
+    k->event = fabwright_i2c_event;
+    k->send = fabwright_i2c_send;
+    k->recv = fabwright_i2c_recv;
+}
+
+static const TypeInfo fabwright_i2c_bridge_info = {
+    .name = TYPE_FABWRIGHT_I2C_BRIDGE,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(FabwrightI2CBridge),
+    .class_init = fabwright_i2c_class_init,
+};
+
+static void fabwright_i2c_register_types(void)
+{
+    type_register_static(&fabwright_i2c_bridge_info);
+}
+
+type_init(fabwright_i2c_register_types)
