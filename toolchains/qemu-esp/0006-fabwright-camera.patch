diff --git a/hw/misc/fabwright_camera.c b/hw/misc/fabwright_camera.c
new file mode 100644
index 0000000..589c85d
--- /dev/null
+++ b/hw/misc/fabwright_camera.c
@@ -0,0 +1,148 @@
+/*
+ * Fabwright camera port: a small virtual peripheral (like Espressif's virtual RGB panel at 0x21000000)
+ * through which a simulation build of the firmware gets camera frames from Fabwright. QEMU does not
+ * model the ESP32 I2S camera mode or the ESP32-S3 LCD_CAM (DVP) block, so the official esp32-camera
+ * driver cannot run here; Fabwright's build wraps its API (esp_camera_init / esp_camera_fb_get / ...)
+ * in simulation builds only and the wrapper talks to this port. The real device build uses the real
+ * driver from the same source.
+ *
+ * Registers at FABWRIGHT_CAMERA_BASE (32-bit):
+ *   0x00 ID       "JCAM" (0x4d41434a)            0x04 VERSION  1
+ *   0x08 WINDOW   address of the frame window      0x0c WINSIZE  its size in bytes
+ *   0x10..0x2c ARG0..ARG7 (read / write)
+ *   0x30 CMD      write: sends "CC <ns> <cmd> <arg0> ... <arg7>" to Fabwright and blocks until it
+ *                 answers "Q <hex>" (up to 8 little-endian words, copied to RES0..RES7). For
+ *                 cmd 2 (capture), when RES0 = 0 and RES1 = frame length, the frame bytes are
+ *                 fetched into the window with "CD <offset> <n>" queries (each answered "Q <hex>").
+ *   0x40..0x5c RES0..RES7 (read only). RES0 = 0xffffffff when no Fabwright is listening.
+ * The window (FABWRIGHT_CAMERA_WINDOW, 4 MB of RAM) holds the last frame; the firmware copies it out.
+ * Protocol reference: Fabwright's packages/sim-backends/src/qemu-esp/protocol.ts.
+ *
+ * This program is free software; you can redistribute it and/or modify it under the terms of the
+ * GNU General Public License version 2 or (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "qemu/timer.h"
+#include "exec/memory.h"
+#include "hw/misc/fabwright_bridge.h"
+#include "hw/misc/fabwright_camera.h"
+
+#define JCAM_ID 0x4d41434au
+#define JCAM_VERSION 1u
+#define JCAM_CMD_CAPTURE 2u
+#define JCAM_CHUNK 4096
+
+typedef struct FabwrightCamera {
+    MemoryRegion iomem;
+    MemoryRegion window;
+    uint32_t args[8];
+    uint32_t res[8];
+} FabwrightCamera;
+
+static FabwrightCamera fabwright_camera;
+
+static void jcam_words(FabwrightCamera *s, const char *hex)
+{
+    uint8_t b[32];
+    int n = fabwright_hex_decode(b, sizeof(b), hex);
+    memset(s->res, 0, sizeof(s->res));
+    for (int i = 0; i < 8 && 4 * i + 3 < n; i++) {
+        s->res[i] = b[4 * i] | (b[4 * i + 1] << 8) | (b[4 * i + 2] << 16) | ((uint32_t)b[4 * i + 3] << 24);
+    }
+}
+
+static void jcam_fetch(FabwrightCamera *s, uint32_t len)
+{
+    static char answer[JCAM_CHUNK * 2 + 16];
+    uint8_t *dst = memory_region_get_ram_ptr(&s->window);
+    uint32_t off = 0;
+    while (off < len) {
+        uint32_t want = MIN((uint32_t)JCAM_CHUNK, len - off);
+        int n = fabwright_bridge_query(answer, sizeof(answer), "CD %x %x\n", off, want);
+        if (n < 0) {
+            s->res[0] = 0xffffffffu;
+            return;
+        }
+        int got = fabwright_hex_decode(dst + off, want, answer);
+        if (got <= 0) {
+            /* Fabwright sent less than it announced: the frame ends here. */
+            s->res[1] = off;
+            return;
+        }
+        off += got;
+    }
+}
+
+static void jcam_command(FabwrightCamera *s, uint32_t cmd)
+{
+    char answer[128];
+    if (!fabwright_bridge_active()) {
+        memset(s->res, 0, sizeof(s->res));
+        s->res[0] = 0xffffffffu;
+        return;
+    }
+    int n = fabwright_bridge_query(answer, sizeof(answer), "CC %" PRIx64 " %x %x %x %x %x %x %x %x %x\n",
+                                fabwright_bridge_now(), cmd, s->args[0], s->args[1], s->args[2], s->args[3],
+                                s->args[4], s->args[5], s->args[6], s->args[7]);
+    if (n < 0) {
+        memset(s->res, 0, sizeof(s->res));
+        s->res[0] = 0xffffffffu;
+        return;
+    }
+    jcam_words(s, answer);
+    if (cmd == JCAM_CMD_CAPTURE && s->res[0] == 0) {
+        if (s->res[1] > FABWRIGHT_CAMERA_WINDOW_SIZE) {
+            s->res[1] = FABWRIGHT_CAMERA_WINDOW_SIZE;
+        }
+        jcam_fetch(s, s->res[1]);
+    }
+}
+
+static uint64_t jcam_read(void *opaque, hwaddr addr, unsigned size)
+{
+    FabwrightCamera *s = opaque;
+    switch (addr) {
+    case 0x00: return JCAM_ID;
+    case 0x04: return JCAM_VERSION;
+    case 0x08: return FABWRIGHT_CAMERA_WINDOW;
+    case 0x0c: return FABWRIGHT_CAMERA_WINDOW_SIZE;
+    default:
+        if (addr >= 0x10 && addr < 0x30) {
+            return s->args[(addr - 0x10) / 4];
+        }
+        if (addr >= 0x40 && addr < 0x60) {
+            return s->res[(addr - 0x40) / 4];
+        }
+        return 0;
+    }
+}
+
+static void jcam_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    FabwrightCamera *s = opaque;
+    if (addr >= 0x10 && addr < 0x30) {
+        s->args[(addr - 0x10) / 4] = (uint32_t)value;
+    } else if (addr == 0x30) {
+        jcam_command(s, (uint32_t)value);
+    }
+}
+
+static const MemoryRegionOps jcam_ops = {
+    .read = jcam_read,
+    .write = jcam_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+void fabwright_camera_attach(MemoryRegion *sys_mem)
+{
+    FabwrightCamera *s = &fabwright_camera;
+    memory_region_init_io(&s->iomem, NULL, &jcam_ops, s, "fabwright.camera", FABWRIGHT_CAMERA_IO_SIZE);
+    memory_region_add_subregion_overlap(sys_mem, FABWRIGHT_CAMERA_BASE, &s->iomem, 1);
+    memory_region_init_ram(&s->window, NULL, "fabwright.camera.window", FABWRIGHT_CAMERA_WINDOW_SIZE, &error_fatal);
+    memory_region_add_subregion_overlap(sys_mem, FABWRIGHT_CAMERA_WINDOW, &s->window, 1);
+}
