diff --git a/include/hw/misc/fabwright_camera.h b/include/hw/misc/fabwright_camera.h
new file mode 100644
index 0000000..62fce58
--- /dev/null
+++ b/include/hw/misc/fabwright_camera.h
@@ -0,0 +1,17 @@
+/*
+ * Fabwright camera port (hw/misc/fabwright_camera.c): frames from Fabwright for simulation builds that use
+ * the esp32-camera API. Next to Espressif's virtual RGB panel (0x20000000 / 0x21000000).
+ *
+ * This program is free software; you can redistribute it and/or modify it under the terms of the
+ * GNU General Public License version 2 or (at your option) any later version.
+ */
+#pragma once
+
+#include "exec/memory.h"
+
+#define FABWRIGHT_CAMERA_BASE        0x21100000
+#define FABWRIGHT_CAMERA_IO_SIZE     0x100
+#define FABWRIGHT_CAMERA_WINDOW      0x22000000
+#define FABWRIGHT_CAMERA_WINDOW_SIZE (4 * 1024 * 1024)
+
+void fabwright_camera_attach(MemoryRegion *sys_mem);
