+/*
+ * Jumper bridge. When the "bridge" chardev property is set, GPIO and I2C activity is mirrored
+ * to Jumper as text lines (one per event), and Jumper drives inputs the same way.
+ *
+ * QEMU -> Jumper
+ *   G <out0> <out1> <en0> <en1> <ns>   output/enable state changed (hex masks, virtual ns)
+ *   IS <addr> <r|w> <ns>               I2C start; Jumper answers "A 0" (ACK) or "A 1" (NACK)
+ *   IW <addr> <byte>                   I2C byte written by the chip (no answer)
+ *   IR <addr>                          I2C byte read by the chip; Jumper answers "D <byte>"
+ *   IP <addr>                          I2C stop (no answer)
+ *   U <ns> <hex bytes>                 bytes UART0 transmitted
+ *   T <ns>                             lockstep only: reached the target, waiting for "R"
+ * Jumper -> QEMU
+ *   I <pin> <0|1>                      drive an input pin
+ *   W <hex bytes>                      bytes into UART0 RX
+ *   R <ns>                             lockstep only: run until virtual time <ns> (needs -icount)
+ *   A <0|1> / D <hex>                  answers, only while QEMU waits for them
+ * All numbers are hex without 0x except <pin> and levels (decimal).
+ */
+static Esp32GpioState *jumper_bridge_gpio;
+static void *jumper_uart;
+static int (*jumper_uart_can_rx)(void *opaque);
+static void (*jumper_uart_rx)(void *opaque, const uint8_t *buf, int size);
+
+void jumper_bridge_offer_uart(void *uart, int (*can_rx)(void *opaque),
+                              void (*rx)(void *opaque, const uint8_t *buf, int size))
+{
+    if (!jumper_uart) {
+        jumper_uart = uart;
+        jumper_uart_can_rx = can_rx;
+        jumper_uart_rx = rx;
+    }
+}
+
+static bool jumper_bridge_active_(void);
+bool jumper_bridge_owns_uart(void *uart)
+{
+    return uart == jumper_uart && jumper_bridge_active_();
+}
+
+bool jumper_bridge_active(void)
+{
+    return jumper_bridge_active_();
+}
+
+static bool jumper_bridge_active_(void)
+{
+    return jumper_bridge_gpio && qemu_chr_fe_backend_connected(&jumper_bridge_gpio->bridge);
+}
+
+static void jumper_bridge_printf(Esp32GpioState *s, const char *fmt, ...) G_GNUC_PRINTF(2, 3);
+static void jumper_bridge_printf(Esp32GpioState *s, const char *fmt, ...)
+{
+    char buf[700];
+    va_list ap;
+    va_start(ap, fmt);
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    if (n > 0 && qemu_chr_fe_backend_connected(&s->bridge)) {
+        qemu_chr_fe_write_all(&s->bridge, (const uint8_t *)buf, MIN(n, (int)sizeof(buf) - 1));
+    }
+}
+
+void jumper_bridge_uart_tx(const uint8_t *buf, int n)
+{
+    char hex[2 * 128 + 1];
+    while (n > 0) {
+        int k = MIN(n, 128);
+        for (int i = 0; i < k; i++) {
+            snprintf(hex + 2 * i, 3, "%02x", buf[i]);
+        }
+        jumper_bridge_printf(jumper_bridge_gpio, "U %" PRIx64 " %s\n",
+                             (uint64_t)qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), hex);
+        buf += k;
+        n -= k;
+    }
+}
+
+static void jumper_bridge_uart_rx_hex(const char *hex)
+{
+    uint8_t bytes[256];
+    int n = 0;
+    unsigned v;
+    while (hex[0] && hex[1] && n < (int)sizeof(bytes) && sscanf(hex, "%2x", &v) == 1) {
+        bytes[n++] = v;
+        hex += 2;
+    }
+    /* Feed what the RX FIFO takes; the rest is dropped (as a real UART overrun would). */
+    if (jumper_uart && n > 0) {
+        int room = jumper_uart_can_rx(jumper_uart);
+        if (room > 0) {
+            jumper_uart_rx(jumper_uart, bytes, MIN(n, room));
+        }
+    }
+}
+
+static void esp32_gpio_notify(Esp32GpioState *s)
+{
+    jumper_bridge_printf(s, "G %x %x %x %x %" PRIx64 "\n", s->out[0], s->out[1],
+                         s->enable[0], s->enable[1],
+                         (uint64_t)qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+}
+
+/* Handles one complete line from Jumper. Returns the answer kind ('A'/'D') with its value. */
+static int jumper_bridge_line(Esp32GpioState *s, const char *line, uint64_t *value)
+{
+    unsigned a = 0, b = 0;
+    if (line[0] == 'I' && sscanf(line + 1, "%u %u", &a, &b) == 2 && a < 64) {
+        uint32_t bit = 1u << (a & 31);
+        if (b) {
+            s->in_ext[a >> 5] |= bit;
+        } else {
+            s->in_ext[a >> 5] &= ~bit;
+        }
+        return 0;
+    }
+    if (line[0] == 'W' && line[1] == ' ') {
+        jumper_bridge_uart_rx_hex(line + 2);
+        return 0;
+    }
+    if (line[0] == 'R' && sscanf(line + 1, "%x", &a) == 1) {
+        uint64_t t = 0;
+        sscanf(line + 1, "%" SCNx64, &t);
+        *value = t;
+        return 'R';
+    }
+    if ((line[0] == 'A' || line[0] == 'D') && sscanf(line + 1, "%x", &a) == 1) {
+        *value = a;
+        return line[0];
+    }
+    return 0;
+}
+
+static int jumper_bridge_feed(Esp32GpioState *s, uint8_t c, uint64_t *value)
+{
+    if (c == '\r') {
+        return 0;
+    }
+    if (c != '\n') {
+        if (s->line_len < (int)sizeof(s->line) - 1) {
+            s->line[s->line_len++] = c;
+        }
+        return 0;
+    }
+    s->line[s->line_len] = 0;
+    s->line_len = 0;
+    return jumper_bridge_line(s, s->line, value);
+}
+
+static int esp32_gpio_can_receive(void *opaque)
+{
+    return 64;
+}
+
+static void esp32_gpio_receive(void *opaque, const uint8_t *buf, int size)
+{
+    Esp32GpioState *s = opaque;
+    uint64_t v;
+    for (int i = 0; i < size; i++) {
+        jumper_bridge_feed(s, buf[i], &v);
+    }
+}
+
+/* Blocks the vCPU until Jumper answers with a line of the wanted kind (inputs are applied on the way). */
+static uint64_t jumper_bridge_wait(Esp32GpioState *s, int kind, uint64_t fallback)
+{
+    for (;;) {
+        uint8_t c;
+        uint64_t v = 0;
+        if (qemu_chr_fe_read_all(&s->bridge, &c, 1) != 1) {
+            return fallback;
+        }
+        if (jumper_bridge_feed(s, c, &v) == kind) {
+            return v;
+        }
+    }
+}
+
+int jumper_bridge_i2c_start(uint8_t addr, bool is_read)
+{
+    Esp32GpioState *s = jumper_bridge_gpio;
+    if (!jumper_bridge_active()) {
+        return 1;
+    }
+    jumper_bridge_printf(s, "IS %x %c %" PRIx64 "\n", addr, is_read ? 'r' : 'w',
+                         (uint64_t)qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    return jumper_bridge_wait(s, 'A', 1) ? 1 : 0;
+}
+
+void jumper_bridge_i2c_send(uint8_t addr, uint8_t byte)
+{
+    if (jumper_bridge_active()) {
+        jumper_bridge_printf(jumper_bridge_gpio, "IW %x %x\n", addr, byte);
+    }
+}
+
+uint8_t jumper_bridge_i2c_recv(uint8_t addr)
+{
+    Esp32GpioState *s = jumper_bridge_gpio;
+    if (!jumper_bridge_active()) {
+        return 0xff;
+    }
+    jumper_bridge_printf(s, "IR %x\n", addr);
+    return jumper_bridge_wait(s, 'D', 0xff) & 0xff;
+}
+
+void jumper_bridge_i2c_stop(uint8_t addr)
+{
+    if (jumper_bridge_active()) {
+        jumper_bridge_printf(jumper_bridge_gpio, "IP %x\n", addr);
+    }
+}
+
+/* Lockstep: at each target, report the time and block until Jumper says how far to run next. */
+static void jumper_sync_cb(void *opaque)
+{
+    Esp32GpioState *s = opaque;
+    if (!jumper_bridge_active()) {
+        return;
+    }
+    jumper_bridge_printf(s, "T %" PRIx64 "\n", (uint64_t)qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    uint64_t target = jumper_bridge_wait(s, 'R', UINT64_MAX);
+    if (target != UINT64_MAX) {
+        timer_mod(s->sync_timer, target);
+    }
+}
+
+static uint32_t esp32_gpio_in(Esp32GpioState *s, int bank)
+{
+    /* A pin reads back its own output when driven, the external level otherwise. */
+    return (s->out[bank] & s->enable[bank]) | (s->in_ext[bank] & ~s->enable[bank]);
+}
