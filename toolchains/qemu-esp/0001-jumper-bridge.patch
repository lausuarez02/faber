+        jumper_bridge_printf(s, "H jumper-esp32-bridge 3 %s sync=%d pads=1\n", object_get_typename(OBJECT(dev)), s->sync);
+        if (s->sync) {
+            s->sync_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, jumper_sync_cb, s);
+            timer_mod(s->sync_timer, 0);
+        }
+    }
 }
 
