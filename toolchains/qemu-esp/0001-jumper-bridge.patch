+/*
+ * Jumper I2C bridge: one slave on the ESP32's I2C bus that answers for every address except the
+ * built-in tmp105 (0x48), forwarding each transaction to Jumper (see hw/gpio/esp32_gpio.c).
+ * Jumper decides per START whether a part sits at that address (ACK) or not (NACK).
+ */
+#include "hw/gpio/esp32_gpio.h"
+
+#define TYPE_JUMPER_I2C_BRIDGE "jumper.i2c-bridge"
+OBJECT_DECLARE_SIMPLE_TYPE(JumperI2CBridge, JUMPER_I2C_BRIDGE)
+
+struct JumperI2CBridge {
+    I2CSlave parent_obj;
+    uint8_t cur_addr;
+};
+
+static bool jumper_i2c_match(I2CSlave *candidate, uint8_t address, bool broadcast,
+                             I2CNodeList *current_devs)
+{
+    JumperI2CBridge *s = JUMPER_I2C_BRIDGE(candidate);
+    if (broadcast || address == 0x48 || !jumper_bridge_active()) {
+        return false;
+    }
+    s->cur_addr = address;
+    I2CNode *node = g_new(struct I2CNode, 1);
+    node->elt = candidate;
+    QLIST_INSERT_HEAD(current_devs, node, next);
+    return true;
+}
+
+static int jumper_i2c_event(I2CSlave *i2c, enum i2c_event event)
+{
+    JumperI2CBridge *s = JUMPER_I2C_BRIDGE(i2c);
+    switch (event) {
+    case I2C_START_SEND:
+    case I2C_START_SEND_ASYNC:
+        return jumper_bridge_i2c_start(s->cur_addr, false) ? -1 : 0;
+    case I2C_START_RECV:
+        return jumper_bridge_i2c_start(s->cur_addr, true) ? -1 : 0;
+    case I2C_FINISH:
+        jumper_bridge_i2c_stop(s->cur_addr);
+        return 0;
+    default:
+        return 0;
+    }
+}
+
+static int jumper_i2c_send(I2CSlave *i2c, uint8_t data)
+{
+    jumper_bridge_i2c_send(JUMPER_I2C_BRIDGE(i2c)->cur_addr, data);
+    return 0;
+}
+
+static uint8_t jumper_i2c_recv(I2CSlave *i2c)
+{
+    return jumper_bridge_i2c_recv(JUMPER_I2C_BRIDGE(i2c)->cur_addr);
+}
+
+static void jumper_i2c_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+    k->match_and_add = jumper_i2c_match;
+    k->event = jumper_i2c_event;
+    k->send = jumper_i2c_send;
+    k->recv = jumper_i2c_recv;
+}
+
+static const TypeInfo jumper_i2c_bridge_info = {
+    .name = TYPE_JUMPER_I2C_BRIDGE,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(JumperI2CBridge),
+    .class_init = jumper_i2c_class_init,
+};
+
+static void jumper_i2c_register_types(void)
+{
+    type_register_static(&jumper_i2c_bridge_info);
+}
+
+type_init(jumper_i2c_register_types)
