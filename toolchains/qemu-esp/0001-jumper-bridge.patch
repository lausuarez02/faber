 static void esp32_gpio_write(void *opaque, hwaddr addr,
                        uint64_t value, unsigned int size)
 {
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    uint32_t v = value;
+    uint32_t o0 = s->out[0], o1 = s->out[1], e0 = s->enable[0], e1 = s->enable[1];
+    switch (addr) {
+    case A_GPIO_OUT:          s->out[0] = v; break;
+    case A_GPIO_OUT_W1TS:     s->out[0] |= v; break;
+    case A_GPIO_OUT_W1TC:     s->out[0] &= ~v; break;
+    case A_GPIO_OUT1:         s->out[1] = v; break;
+    case A_GPIO_OUT1_W1TS:    s->out[1] |= v; break;
+    case A_GPIO_OUT1_W1TC:    s->out[1] &= ~v; break;
+    case A_GPIO_ENABLE:       s->enable[0] = v; break;
+    case A_GPIO_ENABLE_W1TS:  s->enable[0] |= v; break;
+    case A_GPIO_ENABLE_W1TC:  s->enable[0] &= ~v; break;
+    case A_GPIO_ENABLE1:      s->enable[1] = v; break;
+    case A_GPIO_ENABLE1_W1TS: s->enable[1] |= v; break;
+    case A_GPIO_ENABLE1_W1TC: s->enable[1] &= ~v; break;
+    case A_GPIO_STRAP:
+    case A_GPIO_IN:
+    case A_GPIO_IN1:
+        break;
+    default:
+        if (addr < sizeof(s->regs)) {
+            s->regs[addr / 4] = v;
+        }
+        break;
+    }
+    if (o0 != s->out[0] || o1 != s->out[1] || e0 != s->enable[0] || e1 != s->enable[1]) {
+        esp32_gpio_notify(s);
+    }
 }
 
