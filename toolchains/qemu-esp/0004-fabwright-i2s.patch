diff --git a/include/hw/misc/fabwright_i2s.h b/include/hw/misc/fabwright_i2s.h
new file mode 100644
index 0000000..10e193a
--- /dev/null
+++ b/include/hw/misc/fabwright_i2s.h
@@ -0,0 +1,16 @@
+/*
+ * Fabwright I2S: the ESP32-family I2S controllers (ESP32: I2S0/I2S1 with their own DMA; ESP32-S3:
+ * I2S0/I2S1 and ESP32-C3: I2S0, through GDMA), streaming sample frames over the Fabwright bridge.
+ *
+ * This program is free software; you can redistribute it and/or modify it under the terms of the
+ * GNU General Public License version 2 or (at your option) any later version.
+ */
+#pragma once
+
+#include "hw/misc/fabwright_bridge.h"
+
+/*
+ * Creates the chip's I2S controllers and maps them. `gdma` is the GDMA (an ESPGdmaState) on the
+ * S3 / C3 (NULL on the ESP32); `intmatrix` takes the ESP32's I2S interrupt sources.
+ */
+void fabwright_i2s_attach(FabwrightChip chip, MemoryRegion *sys_mem, DeviceState *intmatrix, void *gdma);
