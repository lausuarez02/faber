diff --git a/hw/misc/fabwright_i2s.c b/hw/misc/fabwright_i2s.c
new file mode 100644
index 0000000..0444db7
--- /dev/null
+++ b/hw/misc/fabwright_i2s.c
@@ -0,0 +1,778 @@
+/*
+ * Fabwright I2S: register-level model of the ESP32-family I2S controllers whose audio crosses the
+ * Fabwright bridge as time-stamped blocks of sample frames (hw/gpio/esp32_gpio.c documents the lines):
+ *
+ *   ST <port> <ns> <rate> <bits> <chans> <hex | z<nbytes>>   frames the DMA moved out (TX)
+ *   SR <port> <ns> <rate> <bits> <chans> <frames>             frames the DMA wants in (RX), answer "Q <hex>"
+ *
+ * Samples are little-endian, 2 bytes (bits <= 16) or 4 bytes (24 / 32 bit, sign-extended) each,
+ * interleaved per channel; "z<n>" is n bytes of silence (all-zero blocks are not spelled out).
+ *
+ * What is modelled, for ESP-IDF's i2s_std / i2s_pdm / i2s_tdm drivers (and arduino-esp32's
+ * ESP_I2S on top of them):
+ *   - ESP32-S3 (I2S0, I2S1) and ESP32-C3 (I2S0): the "HW version 2" register block; the DMA is the
+ *     chip's GDMA (hw/dma/esp_gdma.c): the channel whose PERI_SEL names this I2S port, its descriptor
+ *     ring walked here, OUT_EOF / IN_SUC_EOF raised on that GDMA channel with OUT_EOF_DES_ADDR /
+ *     IN_SUC_EOF_DES_ADDR, so the driver's queue of free buffers works as on silicon.
+ *   - ESP32: the "HW version 1" block with its own lldesc DMA (OUT_LINK / IN_LINK) and its own
+ *     interrupt (OUT_EOF, IN_SUC_EOF) through the interrupt matrix.
+ *   - The frame rate comes from the clock registers (source clock, fractional MCLK divider, BCK
+ *     divider, slot width and count; PDM: the up / down sampling ratio), so the virtual time a block
+ *     takes is what it takes on the chip. Formats: 8 / 16 / 24 / 32 bit, mono / stereo / TDM slots,
+ *     PDM RX with PDM-to-PCM (the XIAO ESP32-S3 Sense microphone) and PCM-to-PDM TX, as PCM.
+ * Not modelled: pins (BCK / WS / data edges), the FIFO, slave mode timing, ETM, A-law / u-law,
+ * bit order and endian swaps, the ESP32's 16-bit half-word order, the APLL frequency (assumed to
+ * give the requested rate), raw PDM bit streams.
+ *
+ * This program is free software; you can redistribute it and/or modify it under the terms of the
+ * GNU General Public License version 2 or (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "qemu/timer.h"
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "exec/address-spaces.h"
+#include "hw/dma/esp_gdma.h"
+#include "hw/misc/fabwright_i2s.h"
+
+#define TYPE_FABWRIGHT_I2S "fabwright.i2s"
+OBJECT_DECLARE_SIMPLE_TYPE(FabwrightI2sState, FABWRIGHT_I2S)
+
+/* Bytes of normalized samples per ST line / SR query (a bridge line holds 16 KiB of hex). */
+#define I2S_CHUNK 4096
+/* A descriptor buffer holds at most 4095 bytes (12-bit length). */
+#define I2S_DESC_MAX 4096
+
+typedef struct FabwrightI2sDir {
+    struct FabwrightI2sState *s;
+    bool tx;
+    bool running;
+    uint32_t chan;        /* GDMA channel (S3 / C3) */
+    uint32_t desc;        /* guest address of the descriptor in flight */
+    uint32_t next;        /* its link to the next one */
+    uint32_t len;         /* bytes in the descriptor in flight */
+    uint64_t t0;          /* virtual ns the descriptor in flight started */
+    uint64_t t_end;       /* and ends */
+    QEMUTimer *timer;
+    /* Format latched at start. */
+    double rate;
+    int bits;             /* data bits as configured (8 / 16 / 24 / 32) */
+    int bytes;            /* bytes per sample in DMA memory (1 / 2 / 3 / 4) */
+    int chans;            /* samples per frame in DMA memory */
+    bool lsb24;           /* 24-bit data in a 4-byte container, low-aligned */
+    uint32_t link_start;  /* ESP32: OUT_LINK / IN_LINK address given with START */
+    bool link_armed;
+} FabwrightI2sDir;
+
+struct FabwrightI2sState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t chip;
+    uint32_t port;
+    ESPGdmaState *gdma;
+    uint32_t regs[0x100 / 4];
+    FabwrightI2sDir tx, rx;
+    bool warned;
+};
+
+static bool i2s_v1(FabwrightI2sState *s)
+{
+    return s->chip == FABWRIGHT_CHIP_ESP32;
+}
+
+static uint64_t now_ns(void)
+{
+    return (uint64_t)qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+/* ------------------------------------------------------------------------------- guest memory */
+
+typedef struct {
+    uint32_t dw0;
+    uint32_t buf;
+    uint32_t next;
+} I2sDesc;
+
+#define DESC_SIZE(d)    ((d).dw0 & 0xfff)
+#define DESC_LENGTH(d)  (((d).dw0 >> 12) & 0xfff)
+#define DESC_EOF        (1u << 30)
+#define DESC_OWNER      (1u << 31)
+
+static bool mem_read(uint32_t addr, void *buf, int len)
+{
+    return address_space_read(&address_space_memory, addr, MEMTXATTRS_UNSPECIFIED, buf, len) == MEMTX_OK;
+}
+
+static bool mem_write(uint32_t addr, const void *buf, int len)
+{
+    return address_space_write(&address_space_memory, addr, MEMTXATTRS_UNSPECIFIED, buf, len) == MEMTX_OK;
+}
+
+static bool desc_read(uint32_t addr, I2sDesc *d)
+{
+    uint32_t w[3];
+    if (!addr || !mem_read(addr, w, sizeof(w))) {
+        return false;
+    }
+    d->dw0 = le32_to_cpu(w[0]);
+    d->buf = le32_to_cpu(w[1]);
+    d->next = le32_to_cpu(w[2]);
+    return true;
+}
+
+static void desc_write_dw0(uint32_t addr, uint32_t dw0)
+{
+    uint32_t w = cpu_to_le32(dw0);
+    mem_write(addr, &w, 4);
+}
+
+/* The 20-bit link address a DMA start register holds, as a guest address in internal DRAM. */
+static uint32_t link_to_addr(FabwrightI2sState *s, uint32_t link)
+{
+    uint32_t high = i2s_v1(s) ? 0x3ff00000 : ((ESP_GDMA_RAM_ADDR >> 20) << 20);
+    return high | (link & 0xfffff);
+}
+
+/* ------------------------------------------------------------------------------------- format */
+
+static int popcount32(uint32_t v)
+{
+    return __builtin_popcount(v);
+}
+
+/* MCLK from the source clock and the HW v2 fractional divider: N + b/a. */
+static double mclk_v2(FabwrightI2sState *s, uint32_t clkm, uint32_t div)
+{
+    int sel = (clkm >> 27) & 3;
+    double sclk = sel == 0 ? 40e6 : sel == 1 ? (s->chip == FABWRIGHT_CHIP_ESP32S3 ? 240e6 : 160e6) : sel == 2 ? 160e6 : 0;
+    if (sclk == 0) {
+        return 0;   /* external MCLK input: unknown */
+    }
+    double n = clkm & 0xff;
+    uint32_t z = div & 0x1ff, y = (div >> 9) & 0x1ff, x = (div >> 18) & 0x1ff, yn1 = (div >> 27) & 1;
+    double frac = 0;
+    if (z) {
+        double den = (double)z * (x + 1) + y;
+        frac = (yn1 ? den - z : z) / den;
+    }
+    if (n + frac < 1) {
+        n = 256;   /* N = 0 divides by 256 */
+    }
+    return sclk / (n + frac);
+}
+
+static int bytes_of(int bits, bool fill24)
+{
+    if (bits <= 8) {
+        return 1;
+    }
+    if (bits <= 16) {
+        return 2;
+    }
+    if (bits <= 24) {
+        return fill24 ? 4 : 3;
+    }
+    return 4;
+}
+
+/* Latches rate / bits / bytes / chans of one direction from the registers. Returns false if unknown. */
+static bool latch_format(FabwrightI2sState *s, FabwrightI2sDir *d)
+{
+    uint32_t *r = s->regs;
+    double bclk;
+    d->lsb24 = false;
+    if (i2s_v1(s)) {
+        uint32_t srate = r[0xb0 / 4], clkm = r[0xac / 4], fifo = r[0x20 / 4], pdm = r[0xb4 / 4];
+        int bck = d->tx ? (srate & 0x3f) : ((srate >> 6) & 0x3f);
+        int bits = d->tx ? ((srate >> 12) & 0x3f) : ((srate >> 18) & 0x3f);
+        int fmod = d->tx ? ((fifo >> 13) & 7) : ((fifo >> 16) & 7);
+        double n = clkm & 0xff, b = (clkm >> 8) & 0x3f, a = (clkm >> 14) & 0x3f;
+        /* PLL_D2 (160 MHz); with the APLL (CLKA_EN) the driver tuned it to the rate it asked for, so
+         * the same arithmetic with 160 MHz is close but not exact: noted in docs/esp32-peripherals.md. */
+        double mclk = 160e6 / ((n < 2 ? 2 : n) + (a ? b / a : 0));
+        bclk = mclk / (bck ? bck : 1);
+        d->bytes = (fmod & 2) ? 4 : 2;
+        d->chans = (fmod & 1) ? 1 : 2;
+        d->bits = d->bytes == 4 ? 32 : 16;
+        bool pdm_on = d->tx ? (pdm & 1) : (pdm & 2);
+        if (pdm_on) {
+            int osr = d->tx ? ((pdm >> 4) & 0xf) : (((pdm >> 24) & 1) ? 2 : 1);
+            d->rate = bclk / (64.0 * (osr ? osr : 1));
+            d->bits = 16;
+            d->bytes = 2;
+        } else {
+            d->rate = bclk / (2.0 * (bits ? bits : 16));
+        }
+    } else {
+        uint32_t conf = r[(d->tx ? 0x24 : 0x20) / 4], conf1 = r[(d->tx ? 0x2c : 0x28) / 4];
+        uint32_t clkm = r[(d->tx ? 0x34 : 0x30) / 4], div = r[(d->tx ? 0x3c : 0x38) / 4];
+        uint32_t tdm = r[(d->tx ? 0x54 : 0x50) / 4];
+        double mclk = mclk_v2(s, clkm, div);
+        int bck = (conf1 >> 7) & 0x3f;
+        bclk = mclk / (bck + 1);
+        int chan_bits = ((conf1 >> 24) & 0x1f) + 1;
+        int tot = ((tdm >> 16) & 0xf) + 1;
+        uint32_t mask = tdm & 0xffff & ((1u << tot) - 1);
+        d->bits = ((conf1 >> 13) & 0x1f) + 1;
+        bool fill24 = (conf >> 16) & 1;
+        d->bytes = bytes_of(d->bits, fill24);
+        d->lsb24 = d->bits > 16 && d->bits <= 24 && fill24;
+        bool mono = (conf >> 5) & 1;
+        if (d->tx) {
+            bool pdm = (conf >> 20) & 1;
+            if (pdm) {
+                int osr = (r[0x40 / 4] >> 1) & 0xf;
+                d->rate = bclk / (64.0 * (osr ? osr : 1));
+                d->chans = mono ? 1 : 2;
+            } else {
+                bool skip = (tdm >> 20) & 1;
+                d->rate = bclk / ((double)chan_bits * tot);
+                d->chans = mono ? 1 : skip ? tot : MAX(1, popcount32(mask));
+            }
+        } else {
+            bool pdm = (conf >> 20) & 1;
+            if (pdm) {
+                /* PDM-to-PCM: BCLK = rate x 64 (x128 with the 16x down-sampler). Raw PDM: rate = BCLK x 2. */
+                bool pdm2pcm = (conf >> 21) & 1;
+                d->rate = pdm2pcm ? bclk / (64.0 * (((conf >> 22) & 1) ? 2 : 1)) : bclk * 2;
+                d->chans = MAX(1, popcount32(tdm & 0xff));
+            } else {
+                d->rate = bclk / ((double)chan_bits * tot);
+                d->chans = mono ? 1 : MAX(1, popcount32(mask));
+            }
+        }
+    }
+    if (!(d->rate >= 100 && d->rate <= 2e6)) {
+        if (!s->warned) {
+            s->warned = true;
+            warn_report("fabwright.i2s%u: cannot work out the sample rate from the clock registers (%.0f Hz); using 16000 Hz",
+                        s->port, d->rate);
+        }
+        d->rate = 16000;
+    }
+    return true;
+}
+
+/* Bridge sample size of a direction: 2 bytes (<= 16 bit) or 4. */
+static int norm_bytes(FabwrightI2sDir *d)
+{
+    return d->bytes <= 2 ? 2 : 4;
+}
+
+static int norm_bits(FabwrightI2sDir *d)
+{
+    if (d->bytes <= 2) {
+        return 16;
+    }
+    return d->bytes == 3 || d->lsb24 ? 24 : 32;
+}
+
+/* DMA bytes -> bridge samples (little-endian). Returns the bridge byte count. */
+static int to_bridge(FabwrightI2sDir *d, const uint8_t *src, int n, uint8_t *dst)
+{
+    int k = 0;
+    switch (d->bytes) {
+    case 1:
+        for (int i = 0; i < n; i++) {
+            dst[k++] = 0;
+            dst[k++] = src[i];
+        }
+        break;
+    case 3:
+        for (int i = 0; i + 2 < n; i += 3) {
+            dst[k++] = src[i];
+            dst[k++] = src[i + 1];
+            dst[k++] = src[i + 2];
+            dst[k++] = (src[i + 2] & 0x80) ? 0xff : 0;
+        }
+        break;
+    case 4:
+        for (int i = 0; i + 3 < n; i += 4) {
+            dst[k++] = src[i];
+            dst[k++] = src[i + 1];
+            dst[k++] = src[i + 2];
+            dst[k++] = d->lsb24 ? ((src[i + 2] & 0x80) ? 0xff : 0) : src[i + 3];
+        }
+        break;
+    default:
+        memcpy(dst, src, n & ~1);
+        k = n & ~1;
+        break;
+    }
+    return k;
+}
+
+/* Bridge samples -> DMA bytes. Returns the DMA byte count. */
+static int from_bridge(FabwrightI2sDir *d, const uint8_t *src, int n, uint8_t *dst)
+{
+    int k = 0;
+    switch (d->bytes) {
+    case 1:
+        for (int i = 0; i + 1 < n; i += 2) {
+            dst[k++] = src[i + 1];
+        }
+        break;
+    case 3:
+        for (int i = 0; i + 3 < n; i += 4) {
+            dst[k++] = src[i];
+            dst[k++] = src[i + 1];
+            dst[k++] = src[i + 2];
+        }
+        break;
+    default:
+        memcpy(dst, src, n);
+        k = n;
+        break;
+    }
+    return k;
+}
+
+/* --------------------------------------------------------------------------------- interrupts */
+
+static void i2s_update_irq(FabwrightI2sState *s)
+{
+    if (s->irq) {
+        qemu_set_irq(s->irq, (s->regs[0x0c / 4] & s->regs[0x14 / 4]) != 0);
+    }
+}
+
+/* Raises `mask` on a GDMA channel's interrupt (as esp_gdma.c does for its own transfers). */
+static void gdma_raise(ESPGdmaState *g, int dir, uint32_t chan, uint32_t mask)
+{
+    DmaIntState *st = &g->ch_conf[dir][chan].int_state;
+    uint32_t former = st->st;
+    st->raw |= mask;
+    st->st = st->raw & st->ena;
+    if (former != st->st) {
+        qemu_set_irq(st->irq, st->st ? 1 : 0);
+    }
+}
+
+/* The descriptor `addr` is done: report it as the EOF descriptor and interrupt. */
+static void dir_eof(FabwrightI2sState *s, FabwrightI2sDir *d, uint32_t addr, bool last)
+{
+    if (i2s_v1(s)) {
+        if (d->tx) {
+            s->regs[0x38 / 4] = addr;
+            s->regs[0x0c / 4] |= (1u << 12) | (1u << 11) | (last ? 1u << 16 : 0);
+        } else {
+            s->regs[0x3c / 4] = addr;
+            s->regs[0x0c / 4] |= (1u << 9) | (1u << 8);
+        }
+        i2s_update_irq(s);
+        return;
+    }
+    int dir = d->tx ? ESP_GDMA_OUT_IDX : ESP_GDMA_IN_IDX;
+    s->gdma->ch_conf[dir][d->chan].suc_eof_desc_addr = addr;
+    if (d->tx) {
+        gdma_raise(s->gdma, dir, d->chan, R_GDMA_INTERRUPT_OUT_EOF_MASK | R_GDMA_INTERRUPT_OUT_DONE_MASK |
+                                          (last ? R_GDMA_INTERRUPT_OUT_TOTAL_EOF_MASK : 0));
+    } else {
+        gdma_raise(s->gdma, dir, d->chan, R_GDMA_INTERRUPT_IN_SUC_EOF_MASK | R_GDMA_INTERRUPT_IN_DONE_MASK);
+    }
+}
+
+/* ------------------------------------------------------------------------------------ streams */
+
+static double frame_bytes(FabwrightI2sDir *d)
+{
+    return (double)d->bytes * d->chans;
+}
+
+static uint64_t dur_ns(FabwrightI2sDir *d, uint32_t len)
+{
+    double frames = len / frame_bytes(d);
+    uint64_t ns = (uint64_t)(frames * 1e9 / d->rate + 0.5);
+    return ns ? ns : 1000;
+}
+
+static void dir_stop(FabwrightI2sDir *d)
+{
+    d->running = false;
+    timer_del(d->timer);
+}
+
+/* Reads the descriptor in flight: its length (TX) or size (RX) and its link. */
+static bool desc_load(FabwrightI2sDir *d, I2sDesc *desc)
+{
+    if (!desc_read(d->desc, desc)) {
+        return false;
+    }
+    d->next = desc->next;
+    d->len = d->tx && DESC_LENGTH(*desc) ? DESC_LENGTH(*desc) : DESC_SIZE(*desc);
+    if (!d->len) {
+        d->len = I2S_DESC_MAX - 4;
+    }
+    return true;
+}
+
+/*
+ * TX: the descriptor in flight has played; send what it held as ST lines stamped from its start.
+ * Read at the end of the block, not the start: the DMA reads the buffer progressively while it
+ * plays, so a firmware still filling it just ahead of the DMA (ESP-IDF hands out the next buffer to
+ * play when the ring has run dry) is heard in full, as on the chip.
+ */
+static bool tx_send(FabwrightI2sState *s, FabwrightI2sDir *d)
+{
+    I2sDesc desc;
+    if (!desc_load(d, &desc)) {
+        return false;
+    }
+    uint8_t raw[I2S_DESC_MAX];
+    uint8_t norm[I2S_DESC_MAX * 2];
+    if (!mem_read(desc.buf, raw, d->len)) {
+        return false;
+    }
+    /* Whole frames only; a partial frame at the end is dropped like a FIFO underrun would. */
+    int usable = (int)(d->len / (uint32_t)frame_bytes(d)) * (int)frame_bytes(d);
+    int nb = to_bridge(d, raw, usable, norm);
+    int fb = norm_bytes(d) * d->chans;
+    static char line[I2S_CHUNK * 2 + 8];
+    uint32_t rate = (uint32_t)(d->rate + 0.5);
+    for (int off = 0; off < nb; off += I2S_CHUNK) {
+        int n = MIN(I2S_CHUNK, nb - off);
+        n -= n % fb;
+        if (n <= 0) {
+            break;
+        }
+        uint64_t t = d->t0 + (uint64_t)((off / fb) * 1e9 / d->rate);
+        bool zero = true;
+        for (int i = 0; i < n && zero; i++) {
+            zero = norm[off + i] == 0;
+        }
+        if (zero) {
+            fabwright_bridge_send("ST %x %" PRIx64 " %x %x %x z%x\n", s->port, t, rate, norm_bits(d), d->chans, n);
+        } else {
+            fabwright_hex_encode(line, sizeof(line), norm + off, n);
+            fabwright_bridge_send("ST %x %" PRIx64 " %x %x %x %s\n", s->port, t, rate, norm_bits(d), d->chans, line);
+        }
+    }
+    return true;
+}
+
+/* RX: fill the descriptor in flight with frames from Fabwright (asked at the end of the block). */
+static bool rx_fill(FabwrightI2sState *s, FabwrightI2sDir *d)
+{
+    I2sDesc desc;
+    if (!desc_load(d, &desc)) {
+        return false;
+    }
+    uint32_t size = d->len;
+    int fbr = (int)frame_bytes(d);
+    int frames = size / fbr;
+    int fb = norm_bytes(d) * d->chans;
+    uint8_t raw[I2S_DESC_MAX];
+    uint8_t norm[I2S_CHUNK];
+    static char answer[I2S_CHUNK * 2 + 8];
+    uint32_t rate = (uint32_t)(d->rate + 0.5);
+    int got = 0;
+    int per = I2S_CHUNK / fb;
+    memset(raw, 0, sizeof(raw));
+    for (int f = 0; f < frames; f += per) {
+        int nf = MIN(per, frames - f);
+        uint64_t t = d->t0 + (uint64_t)(f * 1e9 / d->rate);
+        int n = fabwright_bridge_query(answer, sizeof(answer), "SR %x %" PRIx64 " %x %x %x %x\n", s->port, t, rate,
+                                    norm_bits(d), d->chans, nf);
+        memset(norm, 0, sizeof(norm));
+        if (n > 0) {
+            fabwright_hex_decode(norm, nf * fb, answer);
+        }
+        got += from_bridge(d, norm, nf * fb, raw + got);
+    }
+    uint32_t len = frames * fbr;
+    if (len && !mem_write(desc.buf, raw, len)) {
+        return false;
+    }
+    /* Hardware writes the received length, sets SUC_EOF and hands the descriptor back. */
+    desc_write_dw0(d->desc, (desc.dw0 & 0xfff) | (len << 12) | DESC_EOF);
+    return true;
+}
+
+static void dir_tick(void *opaque)
+{
+    FabwrightI2sDir *d = opaque;
+    FabwrightI2sState *s = d->s;
+    if (!d->running) {
+        return;
+    }
+    uint32_t done = d->desc;
+    if (!(d->tx ? tx_send(s, d) : rx_fill(s, d))) {
+        dir_stop(d);
+        return;
+    }
+    bool last = d->next == 0;
+    dir_eof(s, d, done, last);
+    if (last) {
+        dir_stop(d);
+        return;
+    }
+    I2sDesc desc;
+    d->desc = d->next;
+    d->t0 = d->t_end;
+    if (!desc_load(d, &desc)) {
+        dir_stop(d);
+        return;
+    }
+    d->t_end = d->t0 + dur_ns(d, d->len);
+    timer_mod(d->timer, d->t_end);
+}
+
+/* The GDMA channel (S3 / C3) bound to this I2S port in the direction, from its PERI_SEL. */
+static bool gdma_channel(FabwrightI2sState *s, FabwrightI2sDir *d, uint32_t *chan, uint32_t *link)
+{
+    if (!s->gdma) {
+        return false;
+    }
+    ESPGdmaClass *klass = ESP_GDMA_GET_CLASS(s->gdma);
+    int dir = d->tx ? ESP_GDMA_OUT_IDX : ESP_GDMA_IN_IDX;
+    uint32_t want = s->port == 0 ? GDMA_I2S0 : GDMA_I2S1;
+    for (int i = 0; i < klass->m_channel_count; i++) {
+        if (FIELD_EX32(s->gdma->ch_conf[dir][i].peripheral, GDMA_PERI_SEL, PERI_SEL) == want) {
+            *chan = i;
+            *link = s->gdma->ch_conf[dir][i].link;
+            return true;
+        }
+    }
+    return false;
+}
+
+static void dir_start(FabwrightI2sState *s, FabwrightI2sDir *d)
+{
+    uint32_t link = 0;
+    if (i2s_v1(s)) {
+        if (!d->link_armed) {
+            warn_report("fabwright.i2s%u: %s started before its DMA link: nothing moves", s->port, d->tx ? "TX" : "RX");
+            return;
+        }
+        d->desc = d->link_start;
+    } else {
+        if (!gdma_channel(s, d, &d->chan, &link)) {
+            warn_report("fabwright.i2s%u: %s started but no GDMA channel is connected to I2S%u: nothing moves",
+                        s->port, d->tx ? "TX" : "RX", s->port);
+            return;
+        }
+        d->desc = link_to_addr(s, link);
+    }
+    latch_format(s, d);
+    I2sDesc desc;
+    if (!desc_load(d, &desc)) {
+        warn_report("fabwright.i2s%u: %s descriptor at 0x%08x is not readable", s->port, d->tx ? "TX" : "RX", d->desc);
+        return;
+    }
+    d->running = true;
+    d->t0 = now_ns();
+    d->t_end = d->t0 + dur_ns(d, d->len);
+    timer_mod(d->timer, d->t_end);
+}
+
+/* ---------------------------------------------------------------------------------- registers */
+
+static uint64_t i2s_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    FabwrightI2sState *s = opaque;
+    if (addr >= sizeof(s->regs)) {
+        return 0;
+    }
+    uint32_t v = s->regs[addr / 4];
+    if (i2s_v1(s)) {
+        switch (addr) {
+        case 0x10:  /* INT_ST */
+            return s->regs[0x0c / 4] & s->regs[0x14 / 4];
+        case 0xbc:  /* STATE: tx_idle */
+            return s->tx.running ? 0 : 1;
+        case 0xfc:  /* DATE */
+            return 0x1604201;
+        }
+        return v;
+    }
+    switch (addr) {
+    case 0x10:
+        return s->regs[0x0c / 4] & s->regs[0x14 / 4];
+    case 0x6c:
+        return s->tx.running ? 0 : 1;
+    case 0x80:
+        return 0x2101200;
+    }
+    return v;
+}
+
+static void i2s_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    FabwrightI2sState *s = opaque;
+    uint32_t v = value;
+    if (addr >= sizeof(s->regs)) {
+        return;
+    }
+    uint32_t old = s->regs[addr / 4];
+    switch (addr) {
+    case 0x0c:  /* INT_RAW: read-only */
+    case 0x10:  /* INT_ST */
+        return;
+    case 0x18:  /* INT_CLR */
+        s->regs[0x0c / 4] &= ~v;
+        i2s_update_irq(s);
+        return;
+    case 0x14:  /* INT_ENA */
+        s->regs[addr / 4] = v;
+        i2s_update_irq(s);
+        return;
+    }
+    if (i2s_v1(s)) {
+        switch (addr) {
+        case 0x08: {  /* CONF: tx_start bit 4, rx_start bit 5 */
+            s->regs[addr / 4] = v;
+            bool tx_on = (v >> 4) & 1, rx_on = (v >> 5) & 1;
+            if (tx_on && !((old >> 4) & 1)) {
+                dir_start(s, &s->tx);
+            } else if (!tx_on && ((old >> 4) & 1)) {
+                dir_stop(&s->tx);
+            }
+            if (rx_on && !((old >> 5) & 1)) {
+                dir_start(s, &s->rx);
+            } else if (!rx_on && ((old >> 5) & 1)) {
+                dir_stop(&s->rx);
+            }
+            return;
+        }
+        case 0x30:  /* OUT_LINK: addr 0-19, stop 28, start 29, restart 30 */
+        case 0x34: {  /* IN_LINK */
+            FabwrightI2sDir *d = addr == 0x30 ? &s->tx : &s->rx;
+            if (v & (1u << 29)) {
+                d->link_start = link_to_addr(s, v);
+                d->link_armed = true;
+            }
+            if (v & (1u << 28)) {
+                d->link_armed = false;
+                dir_stop(d);
+            }
+            s->regs[addr / 4] = v & 0xfffff;
+            return;
+        }
+        }
+        s->regs[addr / 4] = v;
+        return;
+    }
+    switch (addr) {
+    case 0x20:  /* RX_CONF: rx_start bit 2, rx_update bit 8 (self-clearing) */
+    case 0x24: {  /* TX_CONF: tx_start bit 2, tx_update bit 8 */
+        FabwrightI2sDir *d = addr == 0x24 ? &s->tx : &s->rx;
+        s->regs[addr / 4] = v & ~(1u << 8);
+        bool on = (v >> 2) & 1;
+        if (on && !((old >> 2) & 1)) {
+            dir_start(s, d);
+        } else if (!on && ((old >> 2) & 1)) {
+            dir_stop(d);
+        }
+        return;
+    }
+    }
+    s->regs[addr / 4] = v;
+}
+
+static const MemoryRegionOps i2s_ops = {
+    .read = i2s_read,
+    .write = i2s_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void i2s_reset_hold(Object *obj, ResetType type)
+{
+    FabwrightI2sState *s = FABWRIGHT_I2S(obj);
+    dir_stop(&s->tx);
+    dir_stop(&s->rx);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->tx.link_armed = s->rx.link_armed = false;
+    if (!i2s_v1(s)) {
+        s->regs[0x2c / 4] = 0x7 << 7 | 0xf << 13 | 0xf << 18 | 0xf << 24 | 1 << 30;   /* TX_CONF1 reset value */
+        s->regs[0x28 / 4] = 0x7 << 7 | 0xf << 13 | 0xf << 18 | 0xf << 24 | 1 << 30;   /* RX_CONF1 */
+        s->regs[0x54 / 4] = 0xffff;   /* TX_TDM_CTRL: all channels enabled */
+        s->regs[0x50 / 4] = 0xffff;
+    }
+    i2s_update_irq(s);
+}
+
+static void i2s_realize(DeviceState *dev, Error **errp)
+{
+    FabwrightI2sState *s = FABWRIGHT_I2S(dev);
+    memory_region_init_io(&s->iomem, OBJECT(dev), &i2s_ops, s, TYPE_FABWRIGHT_I2S, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq);
+    s->tx.s = s->rx.s = s;
+    s->tx.tx = true;
+    s->rx.tx = false;
+    s->tx.timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, dir_tick, &s->tx);
+    s->rx.timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, dir_tick, &s->rx);
+}
+
+static Property i2s_props[] = {
+    DEFINE_PROP_UINT32("chip", FabwrightI2sState, chip, 0),
+    DEFINE_PROP_UINT32("port", FabwrightI2sState, port, 0),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void i2s_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    dc->realize = i2s_realize;
+    rc->phases.hold = i2s_reset_hold;
+    device_class_set_props(dc, i2s_props);
+}
+
+static const TypeInfo fabwright_i2s_types[] = {
+    { .name = TYPE_FABWRIGHT_I2S, .parent = TYPE_SYS_BUS_DEVICE, .instance_size = sizeof(FabwrightI2sState), .class_init = i2s_class_init },
+};
+
+DEFINE_TYPES(fabwright_i2s_types)
+
+/* ------------------------------------------------------------------------------------- attach */
+
+static void i2s_create(FabwrightChip chip, MemoryRegion *sys_mem, DeviceState *intmatrix, void *gdma,
+                       int port, hwaddr base, int irq_source)
+{
+    DeviceState *dev = qdev_new(TYPE_FABWRIGHT_I2S);
+    qdev_prop_set_uint32(dev, "chip", chip);
+    qdev_prop_set_uint32(dev, "port", port);
+    FABWRIGHT_I2S(dev)->gdma = gdma ? ESP_GDMA(gdma) : NULL;
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0);
+    memory_region_add_subregion_overlap(sys_mem, base, mr, 1);
+    if (chip == FABWRIGHT_CHIP_ESP32) {
+        /* The same block at its APB alias (0x6000_xxxx). */
+        MemoryRegion *alias = g_new(MemoryRegion, 1);
+        char *name = g_strdup_printf("fabwright-i2s%d-apb", port);
+        memory_region_init_alias(alias, OBJECT(dev), name, mr, 0, memory_region_size(mr));
+        memory_region_add_subregion_overlap(sys_mem, base - 0x3ff40000 + 0x60000000, alias, 1);
+        g_free(name);
+    }
+    if (irq_source >= 0 && intmatrix) {
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0, qdev_get_gpio_in(intmatrix, irq_source));
+    }
+}
+
+void fabwright_i2s_attach(FabwrightChip chip, MemoryRegion *sys_mem, DeviceState *intmatrix, void *gdma)
+{
+    switch (chip) {
+    case FABWRIGHT_CHIP_ESP32:
+        i2s_create(chip, sys_mem, intmatrix, NULL, 0, 0x3ff4f000, 32);
+        i2s_create(chip, sys_mem, intmatrix, NULL, 1, 0x3ff6d000, 33);
+        break;
+    case FABWRIGHT_CHIP_ESP32S3:
+        /* The I2S interrupt itself is unused with GDMA (the driver listens to the GDMA channel). */
+        i2s_create(chip, sys_mem, intmatrix, gdma, 0, 0x6000f000, -1);
+        i2s_create(chip, sys_mem, intmatrix, gdma, 1, 0x6002d000, -1);
+        break;
+    case FABWRIGHT_CHIP_ESP32C3:
+        i2s_create(chip, sys_mem, intmatrix, gdma, 0, 0x6002d000, -1);
+        break;
+    }
+}
