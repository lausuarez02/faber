+};
+
+DEFINE_TYPES(faber_periph_types)
+
+/* ======================================================================================= attach */
+
+static void jp_map(const FaberPeriphConfig *cfg, DeviceState *dev, hwaddr base)
+{
+    MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0);
+    /* Priority 1: these models replace the stubs / unimplemented regions at the same address. */
+    memory_region_add_subregion_overlap(cfg->sys_mem, base, mr, 1);
+    if (cfg->dport_alias) {
+        MemoryRegion *alias = g_new(MemoryRegion, 1);
+        char *name = g_strdup_printf("faber-apb-0x%08x", (uint32_t)base);
+        memory_region_init_alias(alias, OBJECT(dev), name, mr, 0, memory_region_size(mr));
+        memory_region_add_subregion_overlap(cfg->sys_mem, base - 0x3ff40000 + 0x60000000, alias, 1);
+        g_free(name);
+    }
+}
+
+static DeviceState *jp_create(const FaberPeriphConfig *cfg, const char *type, hwaddr base, int irq_source,
+                              const char *prop, uint32_t pval)
+{
+    DeviceState *dev = qdev_new(type);
+    qdev_prop_set_uint32(dev, "chip", cfg->chip);
+    if (prop) {
+        qdev_prop_set_uint32(dev, prop, pval);
+    }
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    jp_map(cfg, dev, base);
+    if (irq_source >= 0) {
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0, qdev_get_gpio_in(cfg->intmatrix, irq_source));
+    }
+    return dev;
+}
+
+void faber_i2c_v2_create(const FaberPeriphConfig *cfg, hwaddr base, int irq_source, int bus_index);
+void faber_i2c_v2_create(const FaberPeriphConfig *cfg, hwaddr base, int irq_source, int bus_index)
+{
+    DeviceState *dev = qdev_new(TYPE_ESP32_I2C);
+    qdev_prop_set_bit(dev, "v2", true);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    jp_map(cfg, dev, base);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0, qdev_get_gpio_in(cfg->intmatrix, irq_source));
+    if (faber_bridge_active()) {
+        I2CBus *bus = I2C_BUS(qdev_get_child_bus(dev, "i2c"));
+        DeviceState *slave = qdev_new("faber.i2c-bridge");
+        qdev_prop_set_uint32(slave, "bus", bus_index);
+        qdev_prop_set_uint8(slave, "address", 0);
+        i2c_slave_realize_and_unref(I2C_SLAVE(slave), bus, &error_fatal);
+    }
+}
+
+void faber_periph_attach(const FaberPeriphConfig *cfg)
+{
+    switch (cfg->chip) {
+    case FABER_CHIP_ESP32:
+        jp_create(cfg, TYPE_FABER_LEDC, 0x3ff59000, 43, NULL, 0);
+        jp_create(cfg, TYPE_FABER_GPSPI, 0x3ff64000, 30, "host", 2);
+        jp_create(cfg, TYPE_FABER_GPSPI, 0x3ff65000, 31, "host", 3);
+        jp_create(cfg, TYPE_FABER_RMT, 0x3ff56000, 47, NULL, 0);
+        jp_create(cfg, TYPE_FABER_ADC, 0x3ff48800, -1, NULL, 0);
+        break;
+    case FABER_CHIP_ESP32S3:
+        jp_create(cfg, TYPE_FABER_LEDC, 0x60019000, 35, NULL, 0);
+        jp_create(cfg, TYPE_FABER_GPSPI, 0x60024000, 21, "host", 2);
+        jp_create(cfg, TYPE_FABER_GPSPI, 0x60025000, 22, "host", 3);
+        jp_create(cfg, TYPE_FABER_RMT, 0x60016000, 40, NULL, 0);
+        jp_create(cfg, TYPE_FABER_ADC, 0x60008800, -1, NULL, 0);
+        faber_i2c_v2_create(cfg, 0x60013000, 42, 0);
+        faber_i2c_v2_create(cfg, 0x60027000, 43, 1);
+        break;
+    case FABER_CHIP_ESP32C3:
+        jp_create(cfg, TYPE_FABER_LEDC, 0x60019000, 23, NULL, 0);
+        jp_create(cfg, TYPE_FABER_GPSPI, 0x60024000, 19, "host", 2);
+        jp_create(cfg, TYPE_FABER_RMT, 0x60016000, 28, NULL, 0);
+        jp_create(cfg, TYPE_FABER_ADC, 0x60040000, -1, NULL, 0);
+        faber_i2c_v2_create(cfg, 0x60013000, 29, 0);
+        break;
+    }
+}
