+/* Faber: the baud rate the firmware configured, reported over the bridge (UART pins are bit-timed there). */
+static void faber_uart_report_baud(ESP32UARTState *s)
+{
+    if (!faber_bridge_owns_uart(s)) {
+        return;
+    }
+    FaberChip chip = faber_bridge_chip();
+    uint32_t div = s->reg[R_UART_CLKDIV];
+    uint32_t clkdiv = div & (chip == FABER_CHIP_ESP32 ? 0xfffff : 0xfff);
+    uint32_t frag = (div >> 20) & 0xf;
+    double sclk;
+    if (chip == FABER_CHIP_ESP32) {
+        /* UART_CONF0 TICK_REF_ALWAYS_ON (bit 27): 1 = APB 80 MHz, 0 = REF_TICK 1 MHz */
+        sclk = (s->reg[R_UART_CONF0] >> 27) & 1 ? 80e6 : 1e6;
+    } else {
+        /* UART_CLK_CONF (0x78): SCLK_SEL bits 20-21 (1 APB 80 MHz, 2 RC_FAST, 3 XTAL 40 MHz), SCLK_DIV_NUM bits 12-19 */
+        uint32_t cc = s->reg[0x78 / 4];
+        uint32_t sel = (cc >> 20) & 3;
+        double src = sel == 1 ? 80e6 : sel == 2 ? 17.5e6 : 40e6;
+        sclk = src / (((cc >> 12) & 0xff) + 1);
+    }
+    uint32_t den = clkdiv * 16 + frag;
+    uint32_t baud = den ? (uint32_t)(sclk * 16 / den + 0.5) : 0;
+    if (baud && baud != s->faber_baud) {
+        s->faber_baud = baud;
+        faber_bridge_uart_baud(s, baud);
+    }
+}
