+static void esp32_gpio_check_int(Esp32GpioState *s, int g, int old, int now)
+{
+    uint32_t type = (pin_reg(s, g) >> 7) & 7;
+    bool hit = false;
+    switch (type) {
+    case 1: hit = !old && now; break;           /* rising edge */
+    case 2: hit = old && !now; break;           /* falling edge */
+    case 3: hit = old != now; break;            /* any edge */
+    case 4: hit = !now; break;                  /* low level */
+    case 5: hit = now; break;                   /* high level */
+    default: break;
+    }
+    if (hit) {
+        s->status[g >> 5] |= 1u << (g & 31);
+    }
