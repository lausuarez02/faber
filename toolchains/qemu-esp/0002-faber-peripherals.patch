diff --git a/include/hw/misc/faber_bridge.h b/include/hw/misc/faber_bridge.h
new file mode 100644
index 0000000..cda84ba
--- /dev/null
+++ b/include/hw/misc/faber_bridge.h
@@ -0,0 +1,49 @@
+/*
+ * Faber bridge: the line protocol between a patched ESP32-family QEMU and Faber (a circuit
+ * simulator that owns virtual time). The bridge itself lives in the GPIO block
+ * (hw/gpio/esp32_gpio.c, it owns the chardev); peripherals use this API to report events and to
+ * ask Faber questions. Protocol reference: hw/gpio/esp32_gpio.c (top comment).
+ *
+ * This program is free software; you can redistribute it and/or modify it under the terms of the
+ * GNU General Public License version 2 or (at your option) any later version.
+ */
+#pragma once
+
+typedef enum FaberChip {
+    FABER_CHIP_ESP32 = 0,
+    FABER_CHIP_ESP32S3 = 1,
+    FABER_CHIP_ESP32C3 = 2,
+} FaberChip;
+
+/* True once the GPIO block's "bridge" chardev is connected. */
+bool faber_bridge_active(void);
+/* The chip the bridge belongs to (from the GPIO block's QOM type). */
+FaberChip faber_bridge_chip(void);
+/* Virtual time in ns (the time base of every event). */
+uint64_t faber_bridge_now(void);
+/* Sends one line (the format must end with "\n"). No-op when the bridge is not active. */
+void faber_bridge_send(const char *fmt, ...) G_GNUC_PRINTF(1, 2);
+/*
+ * Sends a request line and blocks the vCPU until Faber answers "Q <payload>". Copies the payload
+ * (NUL-terminated) into `answer` and returns its length, or -1 when the bridge is gone.
+ */
+int faber_bridge_query(char *answer, int max, const char *fmt, ...) G_GNUC_PRINTF(3, 4);
+/* Lockstep: report "T <now>" and block until Faber says how far to run ("R"). No-op without sync. */
+void faber_bridge_park(void);
+/* Analog level of a pad in mV, as Faber last set it ("E <gpio> <mV>"). 0 when never set. */
+uint32_t faber_bridge_analog_mv(int gpio);
+/* Registers a handler for Faber -> QEMU lines that start with `cmd` (e.g. 'X'); args follow the space. */
+void faber_bridge_on_line(char cmd, void (*fn)(const char *args));
+
+/* Hex helpers: lowercase, two characters per byte. */
+int faber_hex_encode(char *dst, int max, const uint8_t *src, int n);
+int faber_hex_decode(uint8_t *dst, int max, const char *hex);
+
+/* Peripherals the bridge adds to a machine (hw/misc/faber_periph.c). */
+typedef struct FaberPeriphConfig {
+    FaberChip chip;
+    MemoryRegion *sys_mem;
+    DeviceState *intmatrix;      /* interrupt sources are its GPIO inputs */
+    bool dport_alias;            /* ESP32: map at 0x3ff4_xxxx and at the 0x6000_xxxx alias */
+} FaberPeriphConfig;
+void faber_periph_attach(const FaberPeriphConfig *cfg);
