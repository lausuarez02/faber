# syntax=docker/dockerfile:1
# Jumper build image for ESP32-family boards, with simulation networking (round 10).
# = jumper/arduino-esp32:3.3.12-r2 (Dockerfile in this folder: arduino-cli + the pinned esp32 core
# + JumperEth) plus:
#   - JumperSim: the Wi-Fi shim and the TLS trust shim, linked into simulation builds only
#     (JUMPER_SIM=1, the default; JUMPER_SIM=0 builds for the real device, without it).
#   - JumperEth with jumper_eth_install() (used by the shim).
#   - Pinned network libraries sketches commonly use, so the same source builds for the
#     simulation and the device: PubSubClient (MIT), arduino-mqtt "MQTT" (MIT), ArduinoJson (MIT),
#     arduinoWebSockets "WebSockets" (LGPL-2.1, a build input of the person's firmware; see NOTICE).
#
#   docker build -t jumper/arduino-esp32:3.3.12-r3 -f toolchains/arduino-esp32/Dockerfile.sim toolchains/arduino-esp32
ARG BASE_IMAGE=jumper/arduino-esp32:3.3.12-r2
FROM ${BASE_IMAGE}
RUN arduino-cli lib update-index \
 && arduino-cli lib install "PubSubClient@2.8.0" "MQTT@2.5.3" "ArduinoJson@7.4.3" "WebSockets@2.7.2" \
 && rm -rf /opt/arduino/staging /opt/arduino/downloads \
 && chmod -R a+rX /opt/arduino/user/libraries
COPY libraries/JumperEth /opt/arduino/user/libraries/JumperEth
COPY libraries/JumperSim /opt/arduino/user/libraries/JumperSim
COPY jumper-arduino-esp32.sh /usr/local/bin/jumper-arduino-esp32
RUN chmod a+rx /usr/local/bin/jumper-arduino-esp32 && chmod -R a+rX /opt/arduino/user/libraries
