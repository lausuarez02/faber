# syntax=docker/dockerfile:1
# Faber build image for ESP32-family boards, with simulation networking (round 10).
# = faber/arduino-esp32:3.3.12-r2 (Dockerfile in this folder: arduino-cli + the pinned esp32 core
# + FaberEth) plus:
#   - FaberSim: the Wi-Fi shim and the TLS trust shim, linked into simulation builds only
#     (FABER_SIM=1, the default; FABER_SIM=0 builds for the real device, without it).
#   - FaberEth with faber_eth_install() (used by the shim).
#   - FaberCamera (round 13): the esp32-camera shim, linked into simulation builds of sketches that
#     include esp_camera.h (frames from Faber's camera port, QEMU patch 0004).
#   - FaberSleep (round 15): the deep-sleep shim, linked into simulation builds of sketches that call
#     esp_deep_sleep / esp_deep_sleep_start (Faber wakes the board; RTC memory and the clock survive).
#   - Pinned network libraries sketches commonly use, so the same source builds for the
#     simulation and the device: PubSubClient (MIT), arduino-mqtt "MQTT" (MIT), ArduinoJson (MIT),
#     arduinoWebSockets "WebSockets" (LGPL-2.1, a build input of the person's firmware; see NOTICE).
#
#   docker build -t faber/arduino-esp32:3.3.12-r3 -f toolchains/arduino-esp32/Dockerfile.sim toolchains/arduino-esp32
ARG BASE_IMAGE=faber/arduino-esp32:3.3.12-r2
FROM ${BASE_IMAGE}
RUN arduino-cli lib update-index \
 && arduino-cli lib install "PubSubClient@2.8.0" "MQTT@2.5.3" "ArduinoJson@7.4.3" "WebSockets@2.7.2" \
 && rm -rf /opt/arduino/staging /opt/arduino/downloads \
 && chmod -R a+rX /opt/arduino/user/libraries
COPY libraries/FaberEth /opt/arduino/user/libraries/FaberEth
COPY libraries/FaberSim /opt/arduino/user/libraries/FaberSim
COPY libraries/FaberCamera /opt/arduino/user/libraries/FaberCamera
COPY libraries/FaberSleep /opt/arduino/user/libraries/FaberSleep
COPY faber-arduino-esp32.sh /usr/local/bin/faber-arduino-esp32
RUN chmod a+rx /usr/local/bin/faber-arduino-esp32 && chmod -R a+rX /opt/arduino/user/libraries
