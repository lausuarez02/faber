{
  "soil": {
    "id": "soil-moisture-sensor",
    "name": "Capacitive soil moisture sensor v1.2",
    "category": "sensor",
    "description": "Analog soil moisture probe. AOUT falls as the soil gets wetter.",
    "pins": [
      {
        "id": "GND",
        "type": "ground"
      },
      {
        "id": "VCC",
        "type": "power",
        "voltage": {
          "min": 3.3,
          "max": 5.5
        }
      },
      {
        "id": "AOUT",
        "type": "analog"
      }
    ],
    "behavior": {
      "kind": "analog-sensor",
      "output": "AOUT",
      "quantity": {
        "id": "moisture",
        "unit": "%",
        "min": 0,
        "max": 100,
        "default": 40
      },
      "curve": [
        {
          "value": 0,
          "volts": 3
        },
        {
          "value": 100,
          "volts": 1.2
        }
      ]
    },
    "current_ma": {
      "typ": 5,
      "max": 8
    },
    "price_usd": 2.5,
    "dimensions_mm": {
      "w": 98,
      "h": 23,
      "d": 4
    },
    "usage": {
      "wiring": "VCC → 5V, GND → GND, AOUT → A0. Dry soil reads about 614, wet about 245 on an Uno."
    }
  },
