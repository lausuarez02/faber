        "voltage": {
          "min": 4.5,
          "max": 20
        }
      },
      {
        "id": "OUT",
        "type": "digital"
      },
      {
        "id": "GND",
        "type": "ground"
      }
    ],
    "behavior": {
      "kind": "digital-input",
      "output": "OUT",
      "field": "motion"
    },
    "current_ma": {
      "typ": 0.065,
      "max": 0.1
    },
    "price_usd": 1.5,
    "dimensions_mm": {
      "w": 32,
      "h": 24,
      "d": 25
    }
  },
  "uart": {
    "id": "ping-module",
    "name": "Serial ping module",
    "category": "communication",
    "description": "Answers PING with PONG and its counter value, 9600 baud.",
    "pins": [
      {
        "id": "VCC",
        "type": "power",
        "voltage": {
          "min": 3,
          "max": 5.5
        }
      },
      {
        "id": "GND",
        "type": "ground"
      },
      {
        "id": "TX",
        "type": "digital",
        "protocols": [
          "uart-tx"
        ]
      },
      {
        "id": "RX",
        "type": "digital",
        "protocols": [
          "uart-rx"
        ]
      }
    ],
    "behavior": {
      "kind": "uart-device",
      "rx": "RX",
      "tx": "TX",
      "baud": 9600,
      "responses": [
        {
          "match": "PING",
          "reply": "PONG {count}"
        }
      ],
      "unknown_reply": "ERR",
      "fields": [
        {
          "id": "count",
          "min": 0,
          "max": 1000,
          "default": 7,
          "decimals": 0
        }
      ]
    },
    "current_ma": {
      "typ": 10,
      "max": 20
    },
    "price_usd": 4,
    "dimensions_mm": {
      "w": 20,
      "h": 15,
      "d": 3
    }
  }
}
