  "temp": {
    "id": "tmp-sensor-x",
    "name": "I2C temperature sensor (example register map)",
    "category": "sensor",
    "description": "I2C temperature sensor at 0x40: WHO_AM_I 0xA7 at 0x0F, temperature in 0.01 °C at 0x00 (16-bit, big endian), config at 0x10.",
    "pins": [
      {
        "id": "VCC",
        "type": "power",
        "voltage": {
          "min": 1.8,
          "max": 5.5
        }
      },
      {
        "id": "GND",
        "type": "ground"
      },
      {
        "id": "SCL",
        "type": "digital",
        "protocols": [
          "i2c-scl"
        ]
      },
      {
        "id": "SDA",
        "type": "digital",
        "protocols": [
          "i2c-sda"
        ]
      }
    ],
    "behavior": {
      "kind": "i2c-device",
      "address": 64,
      "pullup_ohms": 10000,
      "who_am_i": {
        "reg": 15,
        "value": 167
      },
      "registers": [
        {
          "reg": 0,
          "bytes": 2,
          "field": {
            "id": "temperature",
            "unit": "°C",
            "min": -40,
            "max": 125,
            "default": 22.5,
            "scale": 100,
            "signed": true
          }
        },
        {
          "reg": 16,
          "name": "config",
          "writable": true,
          "value": 0
        }
      ]
    },
    "current_ma": {
      "typ": 1,
      "max": 2
    },
    "price_usd": 3,
    "dimensions_mm": {
      "w": 15,
      "h": 12,
      "d": 3
    }
  },
  "pir": {
    "id": "pir-motion-sensor",
