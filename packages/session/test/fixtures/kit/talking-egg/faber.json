    { "id": "w2", "from": { "part": "bat", "pin": "NEG" }, "to": { "part": "chg", "pin": "GND.2" }, "color": "#2B3038" },
    { "id": "w3", "from": { "part": "chg", "pin": "OUT" }, "to": { "part": "sw", "pin": "2" }, "color": "#FF4D2E" },
    { "id": "w4", "from": { "part": "sw", "pin": "1" }, "to": { "part": "d1", "pin": "A" }, "color": "#B47CFF" },
    { "id": "w5", "from": { "part": "d1", "pin": "C" }, "to": { "part": "xiao", "pin": "VBUS" }, "color": "#FF4D2E" },
