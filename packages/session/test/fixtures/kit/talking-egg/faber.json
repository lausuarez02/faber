{
  "format": "faber/1",
  "name": "Talking Egg",
  "parts": [
    { "id": "xiao", "type": "seeed-xiao-rp2040", "x": 0, "y": 0, "rotation": 0 },
    { "id": "eyes", "type": "ssd1306-oled-i2c", "x": 40, "y": -300, "rotation": 0 },
    { "id": "voice", "type": "dfplayer-mini", "x": 320, "y": -300, "rotation": 0, "props": { "clips": "1: Hi! I'm Eggy!\n2: Hmm... what's out there?\n3: I think I'm about to hatch!\n4: Tell me a story?\n5: Yawn... I'm sleepy." } },
    { "id": "spk", "type": "speaker-20mm", "x": 0, "y": -500, "rotation": 0 },
