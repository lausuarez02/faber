    { "id": "w10", "from": { "part": "eyes", "pin": "SCL" }, "to": { "part": "xiao", "pin": "GP7" }, "color": "#B47CFF" },
    { "id": "w11", "from": { "part": "voice", "pin": "VCC" }, "to": { "part": "sw", "pin": "1" }, "color": "#FF4D2E" },
    { "id": "w12", "from": { "part": "voice", "pin": "GND.1" }, "to": { "part": "xiao", "pin": "GND.1" }, "color": "#2B3038" },
    { "id": "w13", "from": { "part": "xiao", "pin": "GP0" }, "to": { "part": "r1", "pin": "1" }, "color": "#FFB23F" },
    { "id": "w14", "from": { "part": "r1", "pin": "2" }, "to": { "part": "voice", "pin": "RX" }, "color": "#4DA3FF" },
    { "id": "w15", "from": { "part": "voice", "pin": "TX" }, "to": { "part": "xiao", "pin": "GP1" }, "color": "#F2E14A" },
    { "id": "w16", "from": { "part": "voice", "pin": "BUSY" }, "to": { "part": "xiao", "pin": "GP26" }, "color": "#B47CFF" },
    { "id": "w17", "from": { "part": "voice", "pin": "SPK_1" }, "to": { "part": "spk", "pin": "+" }, "color": "#E9EDF2" },
    { "id": "w18", "from": { "part": "voice", "pin": "SPK_2" }, "to": { "part": "spk", "pin": "-" }, "color": "#5CF2A1" },
    { "id": "w19", "from": { "part": "sw", "pin": "1" }, "to": { "part": "rb1", "pin": "1" }, "color": "#FFB23F" },
