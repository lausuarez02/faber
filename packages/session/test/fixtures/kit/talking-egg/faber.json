  "firmware": {
    "board": "xiao",
    "dir": "firmware",
    "sketch": "main.ino",
    "artifact": "firmware/main.hex",
    "build": {
      "tool": "arduino-cli",
      "fqbn": "rp2040:rp2040:seeed_xiao_rp2040"
    },
    "libraries": [
      "Adafruit SSD1306",
      "Adafruit GFX Library"
    ]
  },
  "scenarios": [
    { "id": "boots", "name": "Firmware boots", "steps": [{ "expect_serial": "ready", "within_ms": 1000 }] },
    { "id": "says-hello-and-shows-eyes", "name": "Wakes up, shows eyes and says hello", "steps": [{ "expect_serial": "eyes ready", "within_ms": 3000 }, { "said": "I'm Eggy", "within_ms": 4000 }, { "expect_display": "eyes", "lit": { "min": 80 }, "region": [19, 12, 34, 40], "within_ms": 6000 }, { "expect_display": "eyes", "lit": { "min": 80 }, "region": [75, 12, 34, 40], "within_ms": 6000 }], "timeout_ms": 15000 },
    { "id": "keeps-talking", "name": "Says something else every little while", "steps": [{ "said": "I'm Eggy", "within_ms": 4000 }, { "expect_serial": { "regex": "say clip [234]" }, "within_ms": 20000 }, { "expect_part": "voice.speaking", "op": "==", "value": true, "within_ms": 1000 }], "timeout_ms": 30000 }
  ],
  "assembly": "soldered",
  "power": {"usb":false},
  "enclosure": {
    "shape": "custom",
    "params": {
      "color": "#F4EBDD",
      "dome_mm": 1.5
    },
