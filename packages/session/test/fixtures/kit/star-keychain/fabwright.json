  "firmware": {
    "board": "xiao",
    "dir": "firmware",
    "sketch": "main.ino",
    "artifact": "firmware/main.hex",
    "build": {
      "tool": "arduino-cli",
      "fqbn": "rp2040:rp2040:seeed_xiao_rp2040"
    }
  },
  "scenarios": [
    {
      "id": "boots",
      "name": "Eyes appear on battery power",
      "steps": [
        {
          "expect_serial": "eyes awake",
          "within_ms": 3000
        },
        {
          "run_ms": 300
        },
        {
          "expect_display": "eyes",
          "lit": {
            "min": 4000
          },
          "region": [
            50,
            60,
            140,
            100
          ]
        },
        {
          "expect_part": "bat.currentmA",
          "op": ">",
          "value": 10
        },
        {
          "expect_no_errors": true
        }
      ]
    },
    {
      "id": "blinks",
      "name": "Eyes blink every few seconds",
      "steps": [
        {
          "expect_serial": "eyes awake",
          "within_ms": 3000
        },
        {
          "expect_serial": "blink",
          "within_ms": 6000
        },
        {
          "expect_serial": "blink",
          "within_ms": 6000
        },
        {
          "expect_serial": "blink",
          "within_ms": 6000
        }
      ]
    },
    {
      "id": "looks-around",
      "name": "Eyes glance around",
      "steps": [
        {
          "expect_serial": "eyes awake",
          "within_ms": 3000
        },
        {
          "expect_serial": {
            "regex": "look x=-?[1-9]"
          },
          "within_ms": 10000
        },
        {
          "expect_serial": "look x=",
          "within_ms": 4000
        }
      ]
    },
    {
      "id": "low-battery-sleep",
      "name": "Goes to sleep before the battery runs flat",
      "steps": [
        {
          "expect_serial": "eyes awake",
          "within_ms": 3000
        },
        {
          "set": "bat.soc",
          "value": 3
        },
        {
          "expect_serial": "low battery",
          "within_ms": 7000
        },
        {
          "expect_part": "eyes.sleeping",
          "op": "==",
          "value": true,
          "within_ms": 3000
        }
      ]
    },
    {
      "id": "charges-over-usb",
      "name": "Charges when USB-C is plugged in",
      "steps": [
        {
          "set": "bat.soc",
          "value": 50
        },
        {
          "run_ms": 500
        },
        {
          "set": "chg.usb",
          "value": true
        },
        {
          "expect_part": "chg.charging",
          "op": "==",
          "value": true,
          "within_ms": 1000
        },
        {
          "expect_part": "bat.charging",
          "op": "==",
          "value": true,
          "within_ms": 1000
        }
      ]
    },
    {
      "id": "no-false-sleep",
      "name": "Stays awake on a half-charged battery",
      "steps": [
        {
          "set": "bat.soc",
          "value": 40
        },
        {
          "expect_serial": "eyes awake",
          "within_ms": 3000
        },
        {
          "run_ms": 12000
        },
        {
          "absent": true,
          "expect_serial": "low battery"
        },
        {
          "expect_part": "eyes.sleeping",
          "op": "==",
          "value": false
        }
      ]
    }
  ],
  "assembly": "soldered",
  "power": {
    "usb": false
  },
