// STM32F401 / F411 (WeAct Black Pill F411CE, Nucleo-F401RE) for Jumper: Renode's stm32f4 platform
// (written for the F407 family; the F401 / F411 use the same RCC, GPIO, EXTI, USART, I2C, SPI and
// timer blocks at the same addresses) plus ADC1 (Renode's STM32_ADC, fed by Jumper) and its common
// registers. The board files set the SysTick clock to the core clock.
using "platforms/cpus/stm32f4.repl"

cpu:
    cpuType: "cortex-m4f"

adc1: Analog.STM32_ADC @ sysbus 0x40012000
    IRQ -> nvic@18

adcCommon: Python.PythonPeripheral @ sysbus 0x40012300
    size: 0x100
    initable: true
    filename: "/jumper/platforms/regstore.py"
