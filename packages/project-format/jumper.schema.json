{
  "$id": "urn:jumper:project-format:1",
  "title": "Jumper project (jumper.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "jumper/1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "parts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Unique id of this part in the project, e.g. 'led1'."
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Part type id from the parts registry, e.g. 'led' or 'arduino-uno'."
          },
          "x": {
            "type": "number",
            "description": "Canvas x of the part's top-left corner, in canvas px."
          },
          "y": {
            "type": "number",
            "description": "Canvas y of the part's top-left corner, in canvas px."
          },
          "rotation": {
            "default": 0,
            "description": "Clockwise rotation in degrees.",
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 90
              },
              {
                "type": "number",
                "const": 180
              },
              {
                "type": "number",
                "const": 270
              }
            ]
          },
          "props": {
            "description": "Overrides for the part's props.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "standIn": {
            "description": "Set when this part stands in for a real part Jumper does not have, e.g. 'potentiometer' standing in for 'capacitive soil moisture sensor'. Exports (BOM, WIRING) print the real part and a STAND-IN note.",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type",
          "x",
          "y"
        ]
      }
    },
    "wires": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "from": {
            "type": "object",
            "properties": {
              "part": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                "description": "Part instance id."
              },
              "pin": {
                "type": "string",
                "minLength": 1,
                "description": "Pin id from the part's part.json."
              }
            },
            "required": [
              "part",
              "pin"
            ]
          },
          "to": {
            "type": "object",
            "properties": {
              "part": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                "description": "Part instance id."
              },
              "pin": {
                "type": "string",
                "minLength": 1,
                "description": "Pin id from the part's part.json."
              }
            },
            "required": [
              "part",
              "pin"
            ]
          },
          "color": {
            "description": "CSS color of the wire, e.g. '#FF4D2E'.",
            "type": "string"
          },
          "waypoints": {
            "description": "Bend points between the two pins, in canvas px.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          }
        },
        "required": [
          "id",
          "from",
          "to"
        ]
      }
    },
    "firmware": {
      "type": "object",
      "properties": {
        "board": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "description": "Part id of the MCU board that runs this firmware."
        },
        "dir": {
          "default": "firmware",
          "description": "Firmware folder, relative to jumper.json.",
          "type": "string",
          "const": "firmware"
        },
        "sketch": {
          "description": "Main source file inside dir, e.g. 'blink.ino'.",
          "type": "string"
        },
        "artifact": {
          "type": "string",
          "minLength": 1,
          "description": "Built binary (.hex or .bin), relative to jumper.json."
        },
        "build": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "const": "arduino-cli"
            },
            "fqbn": {
              "type": "string",
              "minLength": 1,
              "description": "Fully qualified board name, e.g. 'arduino:avr:uno'."
            }
          },
          "required": [
            "tool",
            "fqbn"
          ]
        },
        "libraries": {
          "description": "Arduino libraries the sketch needs, 'Name' or 'Name@version', e.g. ['Adafruit SSD1306@2.5.15', 'Servo']. Unversioned names get Jumper's pinned version.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "board",
        "artifact"
      ]
    },
    "scenarios": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Unique scenario id, e.g. 'blinks'."
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "steps": {
            "default": [],
            "description": "Steps run in order. See ScenarioStep.",
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "run_ms": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Advance virtual time by this many ms."
                    },
                    "name": {
                      "description": "Optional label shown in test results.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "run_ms"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "wait_ms": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Same as run_ms: advance virtual time."
                    },
                    "name": {
                      "description": "Optional label shown in test results.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "wait_ms"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "press": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                      "description": "Part to press (button, switch)."
                    },
                    "hold_ms": {
                      "description": "If set: hold this long, then release.",
                      "type": "number",
                      "minimum": 0
                    },
                    "name": {
                      "description": "Optional label shown in test results.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "press"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "release": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                    },
                    "name": {
                      "description": "Optional label shown in test results.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "release"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "set": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*\\.[^\\s]+$",
                      "description": "'part.field': a prop or sensor field, e.g. 'pot1.position', 'sonar1.distance'."
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "name": {
                      "description": "Optional label shown in test results.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "set",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "serial_write": {
                      "type": "string",
                      "description": "Text sent to the board's serial RX."
                    },
                    "name": {
                      "description": "Optional label shown in test results.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "serial_write"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "inject_fault": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                    },
                    "kind": {
                      "type": "string",
                      "description": "disconnect | noisy | i2c_nack | i2c_nack_data | i2c_garbage | clear"
                    },
                    "field": {
                      "description": "noisy: which numeric field jitters (default: the first).",
                      "type": "string"
                    },
                    "amplitude": {
                      "description": "noisy: jitter amplitude in the field's unit (default ±5% of its range).",
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "name": {
                      "description": "Optional label shown in test results.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "inject_fault",
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "expect_serial": {
                      "anyOf": [
                        {
                          "type": "string",
                          "description": "Substring the serial output must contain."
                        },
                        {
                          "type": "object",
                          "properties": {
                            "contains": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "contains"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "regex": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "regex"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "within_ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "absent": {
                      "description": "true: the text must NOT appear (within within_ms, or now).",
                      "type": "boolean"
                    },
                    "name": {
                      "description": "Optional label shown in test results.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "expect_serial"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "expect_pin": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*\\.[^\\s]+$",
                      "description": "'part.pin', e.g. 'uno.D13'."
                    },
                    "level": {
                      "type": "string",
                      "enum": [
                        "high",
                        "low"
                      ]
                    },
                    "voltage": {
                      "description": "Volts range, inclusive.",
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      },
                      "additionalProperties": false
                    },
                    "within_ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "name": {
                      "description": "Optional label shown in test results.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "expect_pin"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "expect_part": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*\\.[^\\s]+$",
                      "description": "'part.field' where field is a key of the part's state (see get_part 'state'), or 'world.field' for the robot / arm physics (collisions, min_clearance_cm, travelled_cm, x, y, heading, sonar_cm, gripper_x, gripper_y, reached)."
                    },
                    "op": {
                      "default": "==",
                      "type": "string",
                      "enum": [
                        "==",
                        "!=",
                        ">",
                        ">=",
                        "<",
                        "<=",
                        "contains",
                        "matches"
                      ]
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "within_ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "name": {
                      "description": "Optional label shown in test results.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "expect_part",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "expect_serial_value": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][\\w.-]*$",
                      "description": "Name printed before a number on serial, e.g. 'hunger' matches \"hunger=40\", \"hunger: 40\" or \"hunger 40\". The latest printed value is compared."
                    },
                    "op": {
                      "default": "==",
                      "type": "string",
                      "enum": [
                        "==",
                        "!=",
                        ">",
                        ">=",
                        "<",
                        "<=",
                        "contains",
                        "matches"
                      ]
                    },
                    "value": {
                      "type": "number"
                    },
                    "within_ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "name": {
                      "description": "Optional label shown in test results.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "expect_serial_value",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "expect_display": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                      "description": "Display part id, e.g. 'oled1'."
                    },
                    "region": {
                      "description": "[x, y, w, h] in screen pixels; default the whole screen.",
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "lit": {
                      "description": "Lit pixel count inside the region, inclusive range.",
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "number",
                          "minimum": 0
                        },
                        "max": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "additionalProperties": false
                    },
                    "matches": {
                      "description": "Name of a golden frame saved with read_display {save_as: name} (snapshots/<name>.txt).",
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                    },
                    "tolerance": {
                      "description": "matches: fraction of region pixels allowed to differ (default 0.02).",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "within_ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "name": {
                      "description": "Optional label shown in test results.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "expect_display"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "expect_no_errors": {
                      "type": "boolean",
                      "const": true,
                      "description": "Fail if any part reports an error diagnostic (overcurrent…)."
                    },
                    "name": {
                      "description": "Optional label shown in test results.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "expect_no_errors"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "timeout_ms": {
            "description": "Abort when virtual time passes this (default 60000).",
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": {}
      }
    },
    "world": {
      "description": "Physical world for robots (arena, obstacles, robot / arm binding). Validated by @jumper/physics parseWorld; kept as-is here.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "format",
    "name"
  ]
}
