{
  "$id": "urn:jumper:project-format:1",
  "title": "Jumper project (jumper.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "jumper/1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "parts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Unique id of this part in the project, e.g. 'led1'."
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Part type id from the parts registry, e.g. 'led' or 'arduino-uno'."
          },
          "x": {
            "type": "number",
            "description": "Canvas x of the part's top-left corner, in canvas px."
          },
          "y": {
            "type": "number",
            "description": "Canvas y of the part's top-left corner, in canvas px."
          },
          "rotation": {
            "default": 0,
            "description": "Clockwise rotation in degrees.",
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 90
              },
              {
                "type": "number",
                "const": 180
              },
              {
                "type": "number",
                "const": 270
              }
            ]
          },
          "props": {
            "description": "Overrides for the part's props.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        "required": [
          "id",
          "type",
          "x",
          "y"
        ]
      }
    },
    "wires": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "from": {
            "type": "object",
            "properties": {
              "part": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                "description": "Part instance id."
              },
              "pin": {
                "type": "string",
                "minLength": 1,
                "description": "Pin id from the part's part.json."
              }
            },
            "required": [
              "part",
              "pin"
            ]
          },
          "to": {
            "type": "object",
            "properties": {
              "part": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                "description": "Part instance id."
              },
              "pin": {
                "type": "string",
                "minLength": 1,
                "description": "Pin id from the part's part.json."
              }
            },
            "required": [
              "part",
              "pin"
            ]
          },
          "color": {
            "description": "CSS color of the wire, e.g. '#FF4D2E'.",
            "type": "string"
          },
          "waypoints": {
            "description": "Bend points between the two pins, in canvas px.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          }
        },
        "required": [
          "id",
          "from",
          "to"
        ]
      }
    },
    "firmware": {
      "type": "object",
      "properties": {
        "board": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "description": "Part id of the MCU board that runs this firmware."
        },
        "dir": {
          "default": "firmware",
          "description": "Firmware folder, relative to jumper.json.",
          "type": "string",
          "const": "firmware"
        },
        "sketch": {
          "description": "Main source file inside dir, e.g. 'blink.ino'.",
          "type": "string"
        },
        "artifact": {
          "type": "string",
          "minLength": 1,
          "description": "Built binary (.hex or .bin), relative to jumper.json."
        },
        "build": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "const": "arduino-cli"
            },
            "fqbn": {
              "type": "string",
              "minLength": 1,
              "description": "Fully qualified board name, e.g. 'arduino:avr:uno'."
            }
          },
          "required": [
            "tool",
            "fqbn"
          ]
        }
      },
      "required": [
        "board",
        "artifact"
      ]
    },
    "scenarios": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "format",
    "name"
  ]
}
