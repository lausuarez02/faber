// GC9A01 1.28in round 240x240 colour display on an Uno (hardware SPI), drawn with Adafruit_GFX.
// Wiring: VCC → 5V, GND → GND, SCL → D13, SDA → D11, RES → D8, DC → D9, CS → D10, BLK → 5V.
// The small GC9A01 class below is all the driver this needs; on other boards a GC9A01 library
// (Adafruit_GC9A01A, TFT_eSPI) does the same.
#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SPITFT.h>

class GC9A01 : public Adafruit_SPITFT {
public:
  GC9A01(int8_t cs, int8_t dc, int8_t rst) : Adafruit_SPITFT(240, 240, cs, dc, rst) {}

  void begin(uint32_t freq = 8000000) {
    initSPI(freq);  // also pulses RES when it is wired
    // Vendor init sequence: cmd, argument count (0x80 = wait after), arguments.
    static const uint8_t init[] PROGMEM = {
      0xEF, 0, 0xEB, 1, 0x14, 0xFE, 0, 0xEF, 0, 0xEB, 1, 0x14,
      0x84, 1, 0x40, 0x85, 1, 0xFF, 0x86, 1, 0xFF, 0x87, 1, 0xFF, 0x88, 1, 0x0A, 0x89, 1, 0x21,
      0x8A, 1, 0x00, 0x8B, 1, 0x80, 0x8C, 1, 0x01, 0x8D, 1, 0x01, 0x8E, 1, 0xFF, 0x8F, 1, 0xFF,
      0xB6, 2, 0x00, 0x20,
      0x36, 1, 0x08,  // MADCTL: BGR, upright
      0x3A, 1, 0x05,  // COLMOD: 16 bit RGB565
      0x90, 4, 0x08, 0x08, 0x08, 0x08, 0xBD, 1, 0x06, 0xBC, 1, 0x00, 0xFF, 3, 0x60, 0x01, 0x04,
      0xC3, 1, 0x13, 0xC4, 1, 0x13, 0xC9, 1, 0x22, 0xBE, 1, 0x11, 0xE1, 2, 0x10, 0x0E,
      0xDF, 3, 0x21, 0x0C, 0x02,
      0xF0, 6, 0x45, 0x09, 0x08, 0x08, 0x26, 0x2A, 0xF1, 6, 0x43, 0x70, 0x72, 0x36, 0x37, 0x6F,
      0xF2, 6, 0x45, 0x09, 0x08, 0x08, 0x26, 0x2A, 0xF3, 6, 0x43, 0x70, 0x72, 0x36, 0x37, 0x6F,
      0xED, 2, 0x1B, 0x0B, 0xAE, 1, 0x77, 0xCD, 1, 0x63,
      0x70, 9, 0x07, 0x07, 0x04, 0x0E, 0x0F, 0x09, 0x07, 0x08, 0x03,
      0xE8, 1, 0x34,
      0x62, 12, 0x18, 0x0D, 0x71, 0xED, 0x70, 0x70, 0x18, 0x0F, 0x71, 0xEF, 0x70, 0x70,
      0x63, 12, 0x18, 0x11, 0x71, 0xF1, 0x70, 0x70, 0x18, 0x13, 0x71, 0xF3, 0x70, 0x70,
      0x64, 7, 0x28, 0x29, 0xF1, 0x01, 0xF1, 0x00, 0x07,
      0x66, 10, 0x3C, 0x00, 0xCD, 0x67, 0x45, 0x45, 0x10, 0x00, 0x00, 0x00,
      0x67, 10, 0x00, 0x3C, 0x00, 0x00, 0x00, 0x01, 0x54, 0x10, 0x32, 0x98,
      0x74, 7, 0x10, 0x85, 0x80, 0x00, 0x00, 0x4E, 0x00,
      0x98, 2, 0x3E, 0x07,
      0x35, 0,          // tearing effect line on
      0x21, 0,          // INVON: this glass needs inversion for true colours
      0x11, 0x80,       // sleep out, wait 120 ms
      0x29, 0x80,       // display on, wait
      0x00
    };
    const uint8_t *p = init;
    uint8_t cmd;
    while ((cmd = pgm_read_byte(p++)) != 0) {
      uint8_t n = pgm_read_byte(p++);
      sendCommand(cmd, p, n & 0x7F);
      p += n & 0x7F;
      if (n & 0x80) delay(120);
    }
    _width = 240;
    _height = 240;
  }

  void setRotation(uint8_t r) {
    static const uint8_t madctl[4] = {0x08, 0x68, 0xC8, 0xA8};  // BGR + rotation 0..3
    rotation = r & 3;
    sendCommand(0x36, (uint8_t *)&madctl[rotation], 1);
  }

  void setAddrWindow(uint16_t x, uint16_t y, uint16_t w, uint16_t h) override {
    writeCommand(0x2A);
    SPI_WRITE16(x);
    SPI_WRITE16(x + w - 1);
    writeCommand(0x2B);
    SPI_WRITE16(y);
    SPI_WRITE16(y + h - 1);
    writeCommand(0x2C);
  }
};

GC9A01 tft(10, 9, 8);

void setup() {
  Serial.begin(115200);
  tft.begin();
  tft.fillScreen(0x0000);
  tft.fillRect(0, 0, 30, 30, 0xFFFF);            // a corner: outside the round glass, never seen
  tft.fillRect(60, 50, 50, 40, 0xF800);          // red
  tft.fillRect(130, 50, 50, 40, 0x07E0);         // green
  tft.fillCircle(120, 170, 30, 0x001F);          // blue
  tft.drawCircle(120, 120, 118, 0xFFFF);         // the rim
  tft.setTextColor(0xFFFF);
  tft.setTextSize(2);
  tft.setCursor(84, 110);
  tft.print("GC9A01");
  Serial.println("GC9A01 drawn");
}

void loop() {}
