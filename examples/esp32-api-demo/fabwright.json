{
  "format": "fabwright/1",
  "name": "API demo (XIAO ESP32-S3)",
  "description": "A Seeed XIAO ESP32-S3 joins Wi-Fi, fetches the weather as JSON over HTTPS (Open-Meteo), shows it on an SSD1306 OLED and posts a reading over MQTT. Tests run offline: the API answers from a recorded cassette, the broker is a mock, and Wi-Fi drops and API errors are rehearsed.",
  "parts": [
    {
      "id": "xiao",
      "type": "seeed-xiao-esp32s3",
      "x": 0,
      "y": 0,
      "rotation": 0
    },
    {
      "id": "oled",
      "type": "ssd1306-oled-i2c",
      "x": 260,
      "y": -40,
      "rotation": 0
    }
  ],
  "wires": [
    {
      "id": "w1",
      "from": {
        "part": "oled",
        "pin": "GND"
      },
      "to": {
        "part": "xiao",
        "pin": "GND"
      },
      "color": "#2B3038"
    },
    {
      "id": "w2",
      "from": {
        "part": "oled",
        "pin": "VCC"
      },
      "to": {
        "part": "xiao",
        "pin": "3V3"
      },
      "color": "#FF4D2E"
    },
    {
      "id": "w3",
      "from": {
        "part": "oled",
        "pin": "SDA"
      },
      "to": {
        "part": "xiao",
        "pin": "GPIO5"
      },
      "color": "#F2E14A"
    },
    {
      "id": "w4",
      "from": {
        "part": "oled",
        "pin": "SCL"
      },
      "to": {
        "part": "xiao",
        "pin": "GPIO6"
      },
      "color": "#B47CFF"
    }
  ],
  "firmware": {
    "board": "xiao",
    "dir": "firmware",
    "sketch": "main.ino",
    "artifact": "firmware/main.bin",
    "build": {
      "tool": "arduino-cli",
      "fqbn": "esp32:esp32:XIAO_ESP32S3"
    },
    "libraries": [
      "ArduinoJson",
      "PubSubClient",
      "Adafruit SSD1306",
      "Adafruit GFX Library"
    ]
  },
  "scenarios": [
    {
      "id": "fetch-and-post",
      "name": "Joins Wi-Fi, fetches the weather over HTTPS and posts a reading over MQTT",
      "steps": [
        {
          "expect_serial": "wifi up 10.0.2.15",
          "within_ms": 15000
        },
        {
          "request": {
            "host": "api.open-meteo.com",
            "path": "/v1/forecast",
            "method": "GET",
            "status": 200
          },
          "within_ms": 15000
        },
        {
          "expect_serial": "weather 16.8 C wind 21.4 km/h",
          "within_ms": 3000
        },
        {
          "request": {
            "host": "test.mosquitto.org",
            "kind": "mqtt"
          },
          "within_ms": 10000
        },
        {
          "expect_serial": "mqtt ack {\"ok\":true}",
          "within_ms": 5000
        }
      ]
    },
    {
      "id": "wifi-drop",
      "name": "Survives a Wi-Fi drop: says it is offline, reconnects by itself and fetches again",
      "steps": [
        {
          "expect_serial": "weather 16.8",
          "within_ms": 30000
        },
        {
          "network_fault": {
            "kind": "wifi_drop"
          }
        },
        {
          "expect_serial": "wifi lost",
          "within_ms": 5000
        },
        {
          "network_fault": {
            "kind": "clear"
          }
        },
        {
          "expect_serial": "wifi up",
          "within_ms": 30000
        },
        {
          "expect_serial": "weather 16.8",
          "within_ms": 20000
        },
        {
          "request": {
            "host": "api.open-meteo.com",
            "path": "/v1/forecast",
            "count": 2
          },
          "within_ms": 5000
        }
      ]
    },
    {
      "id": "api-down",
      "name": "Shows an error when the API answers 503",
      "steps": [
        {
          "network_fault": {
            "kind": "http_error",
            "status": 503,
            "host": "api.open-meteo.com"
          }
        },
        {
          "expect_serial": "weather error 503",
          "within_ms": 30000
        },
        {
          "request": {
            "host": "test.mosquitto.org",
            "kind": "mqtt"
          },
          "absent": true
        }
      ]
    }
  ],
  "network": {
    "mode": "mock",
    "wifi": {
      "ssid": "FabwrightNet"
    },
    "cassette": "open-meteo",
    "allow": [
      {
        "host": "api.open-meteo.com"
      },
      {
        "host": "test.mosquitto.org",
        "ports": [
          1883
        ]
      }
    ]
  }
}
