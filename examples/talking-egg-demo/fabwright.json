{
  "format": "jumper/1",
  "name": "Talking egg (Nano + DFPlayer)",
  "description": "Press the button and the egg says something: an Arduino Nano sends DFPlayer Mini commands over SoftwareSerial, the DFPlayer plays the clip through an 8 ohm speaker. The clips are text (the DFPlayer's clips), so the canvas shows a speech bubble and the browser speaks the words; export_manufacturing writes the microSD card's files.",
  "parts": [
    { "id": "nano", "type": "arduino-nano", "x": 0, "y": 0, "rotation": 0 },
    { "id": "df", "type": "dfplayer-mini", "x": 420, "y": -40, "rotation": 0, "props": { "clips": "1: hi! I'm Eggy\n2: whoa, I'm dizzy!\n3: hehe, that tickles\n4: I love being an egg" } },
    { "id": "spk", "type": "speaker", "x": 660, "y": -20, "rotation": 0 },
    { "id": "r1", "type": "resistor", "x": 300, "y": -120, "rotation": 0, "props": { "resistance": 1000 } },
    { "id": "btn1", "type": "pushbutton", "x": 300, "y": 200, "rotation": 0 }
  ],
  "wires": [
    { "id": "w1", "from": { "part": "df", "pin": "VCC" }, "to": { "part": "nano", "pin": "5V" }, "color": "#FF4D2E" },
    { "id": "w2", "from": { "part": "df", "pin": "GND.1" }, "to": { "part": "nano", "pin": "GND.1" }, "color": "#2B3038" },
    { "id": "w3", "from": { "part": "nano", "pin": "D11" }, "to": { "part": "r1", "pin": "1" }, "color": "#F2E14A" },
    { "id": "w4", "from": { "part": "r1", "pin": "2" }, "to": { "part": "df", "pin": "RX" }, "color": "#F2E14A" },
    { "id": "w5", "from": { "part": "df", "pin": "TX" }, "to": { "part": "nano", "pin": "D10" }, "color": "#5CC8FF" },
    { "id": "w6", "from": { "part": "spk", "pin": "+" }, "to": { "part": "df", "pin": "SPK_1" }, "color": "#FF4D2E" },
    { "id": "w7", "from": { "part": "spk", "pin": "-" }, "to": { "part": "df", "pin": "SPK_2" }, "color": "#2B3038" },
    { "id": "w8", "from": { "part": "btn1", "pin": "1a" }, "to": { "part": "nano", "pin": "D2" }, "color": "#B47CFF" },
    { "id": "w9", "from": { "part": "btn1", "pin": "2a" }, "to": { "part": "nano", "pin": "GND.2" }, "color": "#2B3038" }
  ],
  "firmware": {
    "board": "nano",
    "dir": "firmware",
    "sketch": "main.ino",
    "artifact": "firmware/main.hex",
    "build": {
      "tool": "arduino-cli",
      "fqbn": "arduino:avr:nano:cpu=atmega328"
    }
  },
  "scenarios": [
    { "id": "greets", "name": "It says hi after starting up", "steps": [{ "expect_serial": "player online", "within_ms": 2500 }, { "said": "Eggy", "within_ms": 1000 }, { "expect_part": "df.speaking", "op": "==", "value": true }] },
    { "id": "talks-on-press", "name": "A press makes it say the next line", "steps": [{ "run_ms": 3500 }, { "press": "btn1", "hold_ms": 80 }, { "said": "dizzy", "within_ms": 300 }, { "expect_serial": "done 2", "within_ms": 3000 }, { "press": "btn1", "hold_ms": 80 }, { "said": { "regex": "tickles$" }, "within_ms": 300 }, { "said": "dizzy", "absent": true, "within_ms": 500 }] }
  ]
}
