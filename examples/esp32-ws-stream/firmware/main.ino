WebSocketsClient ws;
static unsigned long chunks = 0, bytes = 0;
static uint32_t sum = 0;
static unsigned long firstMs = 0;

static void onWs(WStype_t type, uint8_t *payload, size_t len) {
  switch (type) {
    case WStype_CONNECTED:
      Serial.println("ws open");
      break;
    case WStype_TEXT:
      Serial.printf("ws text %.*s\n", (int)len, (const char *)payload);
      if (len && strstr((const char *)payload, "ready")) ws.sendTXT("{\"start\":true}");
      if (len && strstr((const char *)payload, "done"))
        Serial.printf("stream done %lu chunks %lu bytes sum %08lx in %lu ms\n", chunks, bytes, (unsigned long)sum, millis() - firstMs);
      break;
    case WStype_BIN:
      if (!chunks) firstMs = millis();
      chunks++;
      bytes += len;
      for (size_t i = 0; i < len; i++) sum = sum * 31 + payload[i];
      if (chunks % 10 == 0) Serial.printf("stream %lu chunks %lu bytes\n", chunks, bytes);
      break;
    case WStype_DISCONNECTED:
      Serial.println("ws closed");
      break;
    default:
      break;
  }
}

void setup() {
  Serial.begin(115200);
  delay(50);
  Serial.println("ws stream boot");
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  while (WiFi.status() != WL_CONNECTED) delay(50);
  Serial.printf("wifi up %s\n", WiFi.localIP().toString().c_str());
  ws.beginSslWithCA(STREAM_HOST, 443, STREAM_PATH, ROOT_CA);
  ws.onEvent(onWs);
  ws.setReconnectInterval(2000);
}

void loop() {
  ws.loop();
}
