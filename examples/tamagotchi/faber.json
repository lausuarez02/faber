{
  "format": "faber/1",
  "name": "Tamagotchi pet",
  "description": "A pixel pet on an SSD1306 OLED: feed, play and put it to sleep with three buttons, it beeps when it needs you. Uno + 128x64 I2C OLED + 3 buttons (INPUT_PULLUP) + active buzzer.",
  "parts": [
    { "id": "uno", "type": "arduino-uno", "x": 0, "y": 0, "rotation": 0 },
    { "id": "oled", "type": "ssd1306-oled-i2c", "x": 620, "y": 120, "rotation": 0, "props": { "color": "white" } },
    { "id": "btnFeed", "type": "pushbutton", "x": 300, "y": 500, "rotation": 0 },
    { "id": "btnPlay", "type": "pushbutton", "x": 420, "y": 500, "rotation": 0 },
    { "id": "btnSleep", "type": "pushbutton", "x": 540, "y": 500, "rotation": 0 },
    { "id": "buzzer", "type": "buzzer", "x": 660, "y": 480, "rotation": 0 }
  ],
  "wires": [
    { "id": "w1", "from": { "part": "oled", "pin": "GND" }, "to": { "part": "uno", "pin": "GND.2" }, "color": "#4A515C" },
    { "id": "w2", "from": { "part": "oled", "pin": "VCC" }, "to": { "part": "uno", "pin": "5V" }, "color": "#FF4D2E" },
    { "id": "w3", "from": { "part": "oled", "pin": "SDA" }, "to": { "part": "uno", "pin": "A4" }, "color": "#3FA9F5" },
    { "id": "w4", "from": { "part": "oled", "pin": "SCL" }, "to": { "part": "uno", "pin": "A5" }, "color": "#F5C542" },
    { "id": "w5", "from": { "part": "uno", "pin": "D2" }, "to": { "part": "btnFeed", "pin": "1a" }, "color": "#B07CFF" },
    { "id": "w6", "from": { "part": "btnFeed", "pin": "2a" }, "to": { "part": "uno", "pin": "GND.3" }, "color": "#4A515C" },
    { "id": "w7", "from": { "part": "uno", "pin": "D3" }, "to": { "part": "btnPlay", "pin": "1a" }, "color": "#B07CFF" },
    { "id": "w8", "from": { "part": "btnPlay", "pin": "2a" }, "to": { "part": "uno", "pin": "GND.3" }, "color": "#4A515C" },
    { "id": "w9", "from": { "part": "uno", "pin": "D4" }, "to": { "part": "btnSleep", "pin": "1a" }, "color": "#B07CFF" },
    { "id": "w10", "from": { "part": "btnSleep", "pin": "2a" }, "to": { "part": "uno", "pin": "GND.3" }, "color": "#4A515C" },
    { "id": "w11", "from": { "part": "uno", "pin": "D8" }, "to": { "part": "buzzer", "pin": "POS" }, "color": "#B07CFF" },
    { "id": "w12", "from": { "part": "buzzer", "pin": "NEG" }, "to": { "part": "uno", "pin": "GND.1" }, "color": "#4A515C" }
  ],
  "firmware": {
    "board": "uno",
    "dir": "firmware",
    "sketch": "tamagotchi/tamagotchi.ino",
    "artifact": "firmware/tamagotchi.hex",
    "build": {
      "tool": "arduino-cli",
      "fqbn": "arduino:avr:uno"
    },
    "libraries": [
      "Adafruit SSD1306@2.5.17",
      "Adafruit GFX Library@1.13.0",
      "Adafruit BusIO@1.17.4"
    ]
  },
  "scenarios": [
    { "id": "boots-and-draws", "name": "Hatches, draws the pet and reports its stats", "steps": [{ "expect_serial": "Pet hatched", "within_ms": 1000 }, { "expect_part": "oled.on", "op": "==", "value": true, "within_ms": 200 }, { "expect_part": "oled.blank", "op": "==", "value": false, "within_ms": 500 }, { "expect_part": "oled.lit", "op": ">", "value": 200, "within_ms": 500 }, { "expect_serial": "t=1 food=78 happy=79 energy=79 mood=happy sleeping=0", "within_ms": 1500 }, { "expect_no_errors": true }] },
    { "id": "feed-fills-food", "name": "Feed raises food by 25 (capped at 100)", "steps": [{ "expect_serial": "t=2 food=76", "within_ms": 3000 }, { "hold_ms": 80, "press": "btnFeed" }, { "expect_serial": "feed food=100", "within_ms": 200 }, { "expect_serial": "t=3 food=98", "within_ms": 1200 }] },
    { "id": "play-beeps", "name": "Play makes it happier, costs energy and beeps", "steps": [{ "run_ms": 1500 }, { "hold_ms": 50, "press": "btnPlay" }, { "expect_pin": "uno.D8", "level": "high" }, { "expect_part": "buzzer.sounding", "op": "==", "value": true }, { "expect_serial": "play happy=99", "within_ms": 100 }, { "expect_pin": "uno.D8", "level": "low", "within_ms": 300 }, { "expect_serial": "energy=68", "within_ms": 1200 }] },
    { "id": "sleep-and-wake", "name": "Sleep dims the screen and restores energy; a second press wakes it", "steps": [{ "run_ms": 1500 }, { "hold_ms": 50, "press": "btnSleep" }, { "expect_serial": { "regex": "\\nsleep\\r\\n" }, "within_ms": 100 }, { "expect_part": "oled.contrast", "op": "==", "value": 16 }, { "expect_serial": "mood=asleep sleeping=1", "within_ms": 1100 }, { "hold_ms": 50, "press": "btnFeed" }, { "expect_serial": "shh, sleeping", "within_ms": 100 }, { "hold_ms": 50, "press": "btnSleep" }, { "expect_serial": "wake", "within_ms": 100 }, { "expect_part": "oled.contrast", "op": "==", "value": 207 }] },
    { "id": "neglect-makes-it-sad", "name": "Left alone it gets sad and beeps for care every 5 s", "steps": [{ "expect_serial": "mood=sad", "within_ms": 40000 }, { "expect_serial": "beep: needs care", "within_ms": 1000 }, { "expect_part": "buzzer.sounding", "op": "==", "value": true, "within_ms": 50 }, { "expect_serial": "beep: needs care", "within_ms": 5500 }] },
    { "id": "runs-headless-without-display", "name": "An OLED that does not answer: the pet keeps running on serial", "steps": [{ "inject_fault": "oled", "kind": "i2c_nack" }, { "expect_serial": "OLED not found at 0x3C, running headless", "within_ms": 1000 }, { "expect_serial": "Pet hatched", "within_ms": 100 }, { "expect_serial": "t=1 food=78", "within_ms": 1500 }, { "expect_part": "oled.blank", "op": "==", "value": true }] }
  ]
}
