{
  "format": "faber/1",
  "name": "Pocket OLED (XIAO RP2040)",
  "description": "A Seeed XIAO RP2040 drives a 0.96 in SSD1306 OLED over I2C (D4/D5): a title, a frame counter and a bar that swings with sinf(). Real arduino-pico firmware on the rp2040js simulator.",
  "parts": [
    { "id": "xiao", "type": "seeed-xiao-rp2040", "x": 0, "y": 0, "rotation": 0 },
    { "id": "oled", "type": "ssd1306-oled-i2c", "x": 260, "y": -40, "rotation": 0 }
  ],
  "wires": [
    { "id": "w1", "from": { "part": "oled", "pin": "GND" }, "to": { "part": "xiao", "pin": "GND.1" }, "color": "#2B3038" },
    { "id": "w2", "from": { "part": "oled", "pin": "VCC" }, "to": { "part": "xiao", "pin": "3V3" }, "color": "#FF4D2E" },
    { "id": "w3", "from": { "part": "oled", "pin": "SDA" }, "to": { "part": "xiao", "pin": "GP6" }, "color": "#F2E14A" },
    { "id": "w4", "from": { "part": "oled", "pin": "SCL" }, "to": { "part": "xiao", "pin": "GP7" }, "color": "#B47CFF" }
  ],
  "firmware": {
    "board": "xiao",
    "dir": "firmware",
    "sketch": "main.ino",
    "artifact": "firmware/main.hex",
    "build": {
      "tool": "arduino-cli",
      "fqbn": "rp2040:rp2040:seeed_xiao_rp2040"
    }
  },
  "scenarios": [
    { "id": "draws", "name": "The OLED shows the counter and the bar moves", "steps": [{ "expect_serial": "frame 3 bar 77", "within_ms": 2000 }, { "expect_part": "oled.blank", "op": "==", "value": false, "within_ms": 500 }] }
  ]
}
