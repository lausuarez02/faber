{
  "format": "faber/1",
  "name": "Two-joint robot arm",
  "description": "Two SG90 servos form a planar arm (shoulder on D9, elbow on D10). Two potentiometers on A0/A1 set the joint angles; the world view shows the arm move.",
  "parts": [
    { "id": "uno", "type": "arduino-uno", "x": 0, "y": 0, "rotation": 0 },
    { "id": "shoulder", "type": "servo-sg90", "x": 660, "y": 20, "rotation": 0 },
    { "id": "elbow", "type": "servo-sg90", "x": 660, "y": 180, "rotation": 0 },
    { "id": "potS", "type": "potentiometer", "x": 140, "y": 480, "rotation": 0, "props": { "position": 0.5 } },
    { "id": "potE", "type": "potentiometer", "x": 260, "y": 480, "rotation": 0, "props": { "position": 0.5 } }
  ],
  "wires": [
    { "id": "w1", "from": { "part": "uno", "pin": "D9" }, "to": { "part": "shoulder", "pin": "SIG" }, "color": "#FFB23F" },
    { "id": "w2", "from": { "part": "uno", "pin": "5V" }, "to": { "part": "shoulder", "pin": "VCC" }, "color": "#FF4D2E" },
    { "id": "w3", "from": { "part": "shoulder", "pin": "GND" }, "to": { "part": "uno", "pin": "GND.2" }, "color": "#4A515C" },
    { "id": "w4", "from": { "part": "uno", "pin": "D10" }, "to": { "part": "elbow", "pin": "SIG" }, "color": "#FFB23F" },
    { "id": "w5", "from": { "part": "uno", "pin": "5V" }, "to": { "part": "elbow", "pin": "VCC" }, "color": "#FF4D2E" },
    { "id": "w6", "from": { "part": "elbow", "pin": "GND" }, "to": { "part": "uno", "pin": "GND.3" }, "color": "#4A515C" },
    { "id": "w7", "from": { "part": "potS", "pin": "1" }, "to": { "part": "uno", "pin": "GND.1" }, "color": "#4A515C" },
    { "id": "w8", "from": { "part": "potS", "pin": "2" }, "to": { "part": "uno", "pin": "5V" }, "color": "#FF4D2E" },
    { "id": "w9", "from": { "part": "potS", "pin": "W" }, "to": { "part": "uno", "pin": "A0" }, "color": "#5CF2A1" },
    { "id": "w10", "from": { "part": "potE", "pin": "1" }, "to": { "part": "uno", "pin": "GND.1" }, "color": "#4A515C" },
    { "id": "w11", "from": { "part": "potE", "pin": "2" }, "to": { "part": "uno", "pin": "5V" }, "color": "#FF4D2E" },
    { "id": "w12", "from": { "part": "potE", "pin": "W" }, "to": { "part": "uno", "pin": "A1" }, "color": "#5CF2A1" }
  ],
  "firmware": {
    "board": "uno",
    "dir": "firmware",
    "sketch": "robot-arm/robot-arm.ino",
    "artifact": "firmware/robot-arm.hex",
    "build": {
      "tool": "arduino-cli",
      "fqbn": "arduino:avr:uno"
    }
  },
  "scenarios": [
    { "id": "reaches-the-cup", "name": "Pots set by inverse kinematics put the gripper in the cup", "steps": [{ "set": "potS.position", "value": 0.187 }, { "set": "potE.position", "value": 0 }, { "wait_ms": 1500 }, { "expect_part": "world.reached", "op": "contains", "value": "cup" }] },
    { "id": "follows-the-pot", "name": "The shoulder servo follows its pot", "steps": [{ "set": "potS.position", "value": 0.75 }, { "expect_part": "shoulder.angle", "op": ">", "value": 130, "within_ms": 1000 }] }
  ],
  "world": {
    "arm": {
      "base": {
        "x": 0,
        "y": 6
      },
      "links": [
        12,
        10
      ],
      "joints": [
        {
          "servo": "shoulder",
          "zero": 0,
          "offset": 0
        },
        {
          "servo": "elbow",
          "zero": 90,
          "offset": 0,
          "direction": 1
        }
      ],
      "targets": [
        {
          "id": "cup",
          "x": 15,
          "y": 4,
          "r": 2
        }
      ]
    }
  }
}
