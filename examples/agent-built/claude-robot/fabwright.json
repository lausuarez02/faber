{
  "format": "fabwright/1",
  "name": "Explorer Bot",
  "parts": [
    { "id": "uno", "type": "arduino-uno", "x": 0, "y": 0, "rotation": 0 },
    { "id": "chassis1", "type": "robot-chassis-2wd", "x": 180, "y": -300, "rotation": 0 },
    { "id": "drv", "type": "l298n", "x": 400, "y": -300, "rotation": 0, "props": { "regulatorJumper": false } },
    { "id": "motorL", "type": "dc-motor", "x": 700, "y": -180, "rotation": 0 },
    { "id": "motorR", "type": "dc-motor", "x": 0, "y": -460, "rotation": 0 },
    { "id": "batt", "type": "battery-pack", "x": 200, "y": -460, "rotation": 0, "props": { "preset": "2S-LiPo" } },
    { "id": "sonar1", "type": "hc-sr04", "x": 420, "y": -480, "rotation": 0 },
    { "id": "oled1", "type": "ssd1306-oled-i2c", "x": 660, "y": -580, "rotation": 0 }
  ],
  "wires": [
    { "id": "w1", "from": { "part": "batt", "pin": "POS" }, "to": { "part": "drv", "pin": "12V" }, "color": "#FF4D2E" },
    { "id": "w2", "from": { "part": "batt", "pin": "POS" }, "to": { "part": "uno", "pin": "VIN" }, "color": "#FF4D2E" },
    { "id": "w3", "from": { "part": "batt", "pin": "NEG" }, "to": { "part": "drv", "pin": "GND" }, "color": "#2B3038" },
    { "id": "w4", "from": { "part": "drv", "pin": "GND" }, "to": { "part": "uno", "pin": "GND.1" }, "color": "#2B3038" },
    { "id": "w5", "from": { "part": "uno", "pin": "D5" }, "to": { "part": "drv", "pin": "ENA" }, "color": "#E9EDF2" },
    { "id": "w6", "from": { "part": "uno", "pin": "D7" }, "to": { "part": "drv", "pin": "IN1" }, "color": "#5CF2A1" },
    { "id": "w7", "from": { "part": "uno", "pin": "D8" }, "to": { "part": "drv", "pin": "IN2" }, "color": "#FFB23F" },
    { "id": "w8", "from": { "part": "uno", "pin": "D6" }, "to": { "part": "drv", "pin": "ENB" }, "color": "#4DA3FF" },
    { "id": "w9", "from": { "part": "uno", "pin": "D2" }, "to": { "part": "drv", "pin": "IN3" }, "color": "#F2E14A" },
    { "id": "w10", "from": { "part": "uno", "pin": "D3" }, "to": { "part": "drv", "pin": "IN4" }, "color": "#B47CFF" },
    { "id": "w11", "from": { "part": "drv", "pin": "OUT1" }, "to": { "part": "motorL", "pin": "A" }, "color": "#E9EDF2" },
    { "id": "w12", "from": { "part": "drv", "pin": "OUT2" }, "to": { "part": "motorL", "pin": "B" }, "color": "#5CF2A1" },
    { "id": "w13", "from": { "part": "drv", "pin": "OUT3" }, "to": { "part": "motorR", "pin": "A" }, "color": "#FFB23F" },
    { "id": "w14", "from": { "part": "drv", "pin": "OUT4" }, "to": { "part": "motorR", "pin": "B" }, "color": "#4DA3FF" },
    { "id": "w15", "from": { "part": "sonar1", "pin": "VCC" }, "to": { "part": "uno", "pin": "5V" }, "color": "#FF4D2E" },
    { "id": "w16", "from": { "part": "sonar1", "pin": "GND" }, "to": { "part": "uno", "pin": "GND.2" }, "color": "#2B3038" },
    { "id": "w17", "from": { "part": "uno", "pin": "D9" }, "to": { "part": "sonar1", "pin": "TRIG" }, "color": "#E9EDF2" },
    { "id": "w18", "from": { "part": "sonar1", "pin": "ECHO" }, "to": { "part": "uno", "pin": "D10" }, "color": "#5CF2A1" },
    { "id": "w19", "from": { "part": "oled1", "pin": "VCC" }, "to": { "part": "uno", "pin": "5V" }, "color": "#FF4D2E" },
    { "id": "w20", "from": { "part": "oled1", "pin": "GND" }, "to": { "part": "uno", "pin": "GND.3" }, "color": "#2B3038" },
    { "id": "w21", "from": { "part": "oled1", "pin": "SDA" }, "to": { "part": "uno", "pin": "A4" }, "color": "#F2E14A" },
    { "id": "w22", "from": { "part": "oled1", "pin": "SCL" }, "to": { "part": "uno", "pin": "A5" }, "color": "#B47CFF" },
    { "id": "w23", "from": { "part": "drv", "pin": "5V" }, "to": { "part": "uno", "pin": "5V" }, "color": "#FF4D2E" }
  ],
  "firmware": {
    "board": "uno",
    "dir": "firmware",
    "sketch": "main.ino",
    "artifact": "firmware/main.hex",
    "build": {
      "tool": "arduino-cli",
      "fqbn": "arduino:avr:uno"
    },
    "libraries": [
      "Adafruit SSD1306",
      "Adafruit GFX Library"
    ]
  },
  "scenarios": [
    { "id": "boots", "name": "Firmware boots", "steps": [{ "expect_serial": "ready", "within_ms": 500 }] },
    { "description": "From power-on the robot drives itself around the walled arena with a crate, pillar and box. After exactly 60 s it must have touched nothing, kept at least 3 cm clearance, covered real ground and dodged many times.", "id": "explores-60s-no-collision", "name": "Explores the arena for 60 s without colliding", "steps": [{ "run_ms": 60000 }, { "expect_serial": "Explorer Bot ready" }, { "expect_serial": "dodge #10 " }, { "expect_part": "world.collisions", "op": "==", "value": 0 }, { "expect_part": "world.min_clearance_cm", "op": ">=", "value": 3 }, { "expect_part": "world.travelled_cm", "op": ">=", "value": 1000 }, { "expect_no_errors": true }], "timeout_ms": 70000 },
    { "description": "The OLED shows the happy face when cruising; when the sonar sees an obstacle the screen switches to the surprised face, and back to happy once the way is clear.", "id": "face-changes-on-dodge", "name": "Face is happy while cruising, surprised while dodging", "steps": [{ "expect_display": "oled1", "matches": "happy-face", "within_ms": 1000 }, { "expect_serial": "face=happy", "within_ms": 100 }, { "expect_serial": "dodge #1 ", "within_ms": 10000 }, { "expect_display": "oled1", "matches": "surprised-face", "within_ms": 200 }, { "expect_serial": "clear dist=", "within_ms": 4000 }, { "expect_display": "oled1", "matches": "happy-face", "within_ms": 200 }, { "expect_serial": "dodge #2 ", "within_ms": 15000 }, { "expect_display": "oled1", "matches": "surprised-face", "within_ms": 200 }] }
  ],
  "world": {
    "arena": {
      "width": 250,
      "height": 200
    },
    "obstacles": [
      {
        "id": "crate",
        "shape": "box",
        "x": 150,
        "y": 70,
        "w": 36,
        "h": 36,
        "angle": 15
      },
      {
        "id": "pillar",
        "shape": "circle",
        "x": 80,
        "y": 140,
        "r": 10
      },
      {
        "id": "box",
        "shape": "box",
        "x": 195,
        "y": 150,
        "w": 30,
        "h": 24,
        "angle": 0
      }
    ],
    "robot": {
      "chassis": "chassis1",
      "leftMotor": "motorL",
      "rightMotor": "motorR",
      "sonar": "sonar1",
      "start": {
        "x": 40,
        "y": 40,
        "heading": 0
      }
    }
  }
}
