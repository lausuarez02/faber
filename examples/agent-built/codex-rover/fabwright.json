  "firmware": {
    "board": "uno",
    "dir": "firmware",
    "sketch": "main.ino",
    "artifact": "firmware/main.hex",
    "build": {
      "tool": "arduino-cli",
      "fqbn": "arduino:avr:uno"
    }
  },
  "scenarios": [
    { "description": "Real arena sonar, nonzero travel, zero accumulated collisions and at least 3 cm clearance.", "id": "arena-30-seconds", "name": "Drive safely for 30 seconds", "steps": [{ "run_ms": 30000 }, { "expect_part": "world.collisions", "op": "==", "value": 0 }, { "expect_part": "world.min_clearance_cm", "op": ">=", "value": 3 }, { "expect_part": "world.travelled_cm", "op": ">", "value": 500 }, { "expect_no_errors": true }] },
    { "description": "Approach a real arena wall, observe threshold crossing, verify opposite wheel directions and a changed heading, then clearance and forward recovery.", "id": "wall-under-20", "name": "Turn away below 20 cm", "steps": [{ "expect_part": "world.sonar_cm", "op": ">", "value": 20 }, { "expect_part": "driver.aState", "op": "==", "value": "fwd", "within_ms": 300 }, { "expect_part": "driver.bState", "op": "==", "value": "fwd" }, { "expect_part": "world.sonar_cm", "op": "<", "value": 20, "within_ms": 10000 }, { "expect_serial_value": "distance_cm", "op": "<", "value": 20, "within_ms": 150 }, { "expect_part": "driver.bState", "op": "==", "value": "rev", "within_ms": 400 }, { "expect_part": "driver.aState", "op": "==", "value": "fwd" }, { "run_ms": 250 }, { "expect_part": "world.heading", "op": ">", "value": 10 }, { "expect_part": "world.sonar_cm", "op": ">", "value": 25, "within_ms": 2500 }, { "expect_part": "driver.bState", "op": "==", "value": "fwd", "within_ms": 1500 }, { "expect_part": "world.collisions", "op": "==", "value": 0 }, { "expect_part": "world.min_clearance_cm", "op": ">=", "value": 3 }, { "expect_no_errors": true }] }
  ],
  "world": {
    "arena": {
      "width": 200,
      "height": 150
    },
    "robot": {
      "chassis": "chassis",
      "leftMotor": "left",
      "rightMotor": "right",
      "sonar": "sonar",
      "start": {
        "x": 45,
        "y": 75,
        "heading": 0
      }
    }
  }
}
