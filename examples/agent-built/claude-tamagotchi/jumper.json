{
  "format": "jumper/1",
  "name": "tamagotchi",
  "parts": [
    { "id": "uno", "type": "arduino-uno", "x": 0, "y": 0, "rotation": 0 },
    { "id": "oled1", "type": "ssd1306-oled-i2c", "x": 180, "y": -300, "rotation": 0 },
    { "id": "btnFeed", "type": "pushbutton", "x": 460, "y": -180, "rotation": 0 },
    { "id": "btnPlay", "type": "pushbutton", "x": 600, "y": -180, "rotation": 0 },
    { "id": "btnSleep", "type": "pushbutton", "x": 740, "y": -180, "rotation": 0 },
    { "id": "buzzer1", "type": "buzzer", "x": 880, "y": -180, "rotation": 0 }
  ],
  "wires": [
    { "id": "w1", "from": { "part": "oled1", "pin": "GND" }, "to": { "part": "uno", "pin": "GND.1" }, "color": "#2B3038" },
    { "id": "w2", "from": { "part": "oled1", "pin": "VCC" }, "to": { "part": "uno", "pin": "5V" }, "color": "#FF4D2E" },
    { "id": "w3", "from": { "part": "oled1", "pin": "SCL" }, "to": { "part": "uno", "pin": "A5" }, "color": "#F2E14A" },
    { "id": "w4", "from": { "part": "oled1", "pin": "SDA" }, "to": { "part": "uno", "pin": "A4" }, "color": "#B47CFF" },
    { "id": "w5", "from": { "part": "btnFeed", "pin": "1a" }, "to": { "part": "uno", "pin": "D2" }, "color": "#E9EDF2" },
    { "id": "w6", "from": { "part": "btnFeed", "pin": "2a" }, "to": { "part": "uno", "pin": "GND.2" }, "color": "#2B3038" },
    { "id": "w7", "from": { "part": "btnPlay", "pin": "1a" }, "to": { "part": "uno", "pin": "D4" }, "color": "#FFB23F" },
    { "id": "w8", "from": { "part": "btnPlay", "pin": "2a" }, "to": { "part": "uno", "pin": "GND.3" }, "color": "#2B3038" },
    { "id": "w9", "from": { "part": "btnSleep", "pin": "1a" }, "to": { "part": "uno", "pin": "D7" }, "color": "#F2E14A" },
    { "id": "w10", "from": { "part": "btnSleep", "pin": "2a" }, "to": { "part": "uno", "pin": "GND.1" }, "color": "#2B3038" },
    { "id": "w11", "from": { "part": "buzzer1", "pin": "POS" }, "to": { "part": "uno", "pin": "D8" }, "color": "#E9EDF2" },
    { "id": "w12", "from": { "part": "buzzer1", "pin": "NEG" }, "to": { "part": "uno", "pin": "GND.1" }, "color": "#2B3038" }
  ],
  "firmware": {
    "board": "uno",
    "dir": "firmware",
    "sketch": "main.ino",
    "artifact": "firmware/main.hex",
    "build": {
      "tool": "arduino-cli",
      "fqbn": "arduino:avr:uno"
    },
    "libraries": [
      "Adafruit SSD1306",
      "Adafruit GFX Library"
    ]
  },
  "scenarios": [
    { "id": "boots", "name": "Pet boots happy with face on screen", "steps": [{ "expect_serial": "OLED ready", "within_ms": 500 }, { "expect_serial": { "regex": "t=0 hunger=20 happy=80 energy=80 mood=happy" }, "within_ms": 500 }, { "expect_part": "oled1.lit", "op": ">", "value": 300, "within_ms": 1000 }, { "expect_display": "oled1", "lit": { "min": 60 }, "region": [44, 22, 40, 16], "within_ms": 1000 }, { "expect_no_errors": true }] },
    { "id": "feed-lowers-hunger", "name": "Pressing FEED lowers hunger", "steps": [{ "run_ms": 10500 }, { "expect_serial_value": "hunger", "op": ">=", "value": 40 }, { "expect_part": "buzzer1.sounding", "op": "==", "value": false }, { "hold_ms": 60, "press": "btnFeed" }, { "expect_part": "buzzer1.sounding", "op": "==", "value": true, "within_ms": 100 }, { "expect_serial": "EVENT feed: hunger=", "within_ms": 300 }, { "expect_serial_value": "hunger", "op": "<=", "value": 12, "within_ms": 300 }] },
    { "id": "play-raises-happiness", "name": "Pressing PLAY raises happiness and costs energy", "steps": [{ "run_ms": 20500 }, { "expect_serial_value": "happy", "op": "<=", "value": 60 }, { "expect_serial_value": "energy", "op": ">=", "value": 70 }, { "hold_ms": 150, "press": "btnPlay" }, { "expect_serial": "EVENT play: happy=", "within_ms": 300 }, { "expect_serial_value": "happy", "op": ">=", "value": 78, "within_ms": 300 }, { "expect_serial_value": "energy", "op": "<=", "value": 63, "within_ms": 1200 }] },
    { "id": "neglect-makes-sad-and-beeps", "name": "Ignored pet gets hungry, beeps, then turns sad", "steps": [{ "expect_display": "oled1", "matches": "happy-mouth", "within_ms": 2000 }, { "absent": true, "expect_serial": "BEEP", "within_ms": 20000 }, { "expect_serial": "MOOD happy -> ok", "within_ms": 20000 }, { "expect_serial": "BEEP need=food", "within_ms": 10000 }, { "expect_part": "buzzer1.sounding", "op": "==", "value": true, "within_ms": 500 }, { "expect_serial": "mood=hungry", "within_ms": 1500 }, { "expect_serial": "-> sad", "within_ms": 20000 }, { "expect_serial_value": "happy", "op": "<", "value": 35, "within_ms": 1000 }, { "expect_serial": "mood=sad", "within_ms": 1000 }, { "expect_display": "oled1", "matches": "sad-mouth", "within_ms": 1000 }, { "expect_serial": "BEEP need=", "within_ms": 5000 }, { "expect_part": "buzzer1.sounding", "op": "==", "value": true, "within_ms": 500 }] },
    { "id": "sleep-restores-energy", "name": "SLEEP restores energy and the pet wakes up rested", "steps": [{ "run_ms": 1200 }, { "expect_serial_value": "energy", "op": ">=", "value": 79 }, { "hold_ms": 150, "press": "btnPlay" }, { "run_ms": 300 }, { "hold_ms": 150, "press": "btnPlay" }, { "run_ms": 300 }, { "hold_ms": 150, "press": "btnPlay" }, { "expect_serial_value": "energy", "op": "<=", "value": 60, "within_ms": 1500 }, { "hold_ms": 150, "press": "btnSleep" }, { "expect_serial": "EVENT sleep: zzz", "within_ms": 300 }, { "expect_serial": "mood=sleeping", "within_ms": 1500 }, { "hold_ms": 150, "press": "btnFeed" }, { "expect_serial": "EVENT feed ignored: sleeping", "within_ms": 300 }, { "expect_serial_value": "energy", "op": ">=", "value": 80, "within_ms": 8000 }, { "expect_serial": "EVENT wake: rested", "within_ms": 10000 }, { "expect_serial_value": "energy", "op": "==", "value": 100, "within_ms": 1500 }] },
    { "id": "cared-for-pet-stays-quiet", "name": "A pet that is fed and played with never beeps for help", "steps": [{ "run_ms": 15000 }, { "hold_ms": 150, "press": "btnFeed" }, { "run_ms": 10000 }, { "hold_ms": 150, "press": "btnPlay" }, { "run_ms": 5000 }, { "hold_ms": 150, "press": "btnFeed" }, { "run_ms": 15000 }, { "hold_ms": 150, "press": "btnFeed" }, { "run_ms": 5000 }, { "hold_ms": 150, "press": "btnPlay" }, { "run_ms": 10000 }, { "hold_ms": 150, "press": "btnFeed" }, { "run_ms": 15000 }, { "hold_ms": 150, "press": "btnFeed" }, { "run_ms": 5000 }, { "absent": true, "expect_serial": "BEEP need" }, { "expect_serial_value": "happy", "op": ">=", "value": 35 }, { "expect_serial_value": "hunger", "op": "<", "value": 70 }], "timeout_ms": 120000 },
    { "id": "care-cheers-up-sad-pet", "name": "Feeding and playing with a sad pet makes it smile again", "steps": [{ "run_ms": 36500 }, { "expect_serial": "mood=sad", "within_ms": 1000 }, { "hold_ms": 100, "press": "btnFeed" }, { "run_ms": 200 }, { "hold_ms": 100, "press": "btnFeed" }, { "run_ms": 200 }, { "hold_ms": 100, "press": "btnPlay" }, { "run_ms": 200 }, { "hold_ms": 100, "press": "btnPlay" }, { "expect_serial": "-> happy", "within_ms": 1500 }, { "expect_display": "oled1", "matches": "happy-mouth", "within_ms": 2000 }, { "run_ms": 8000 }, { "absent": true, "expect_serial": "BEEP need" }] },
    { "id": "oled-missing-pet-still-runs", "name": "OLED unplugged: firmware reports it and the pet keeps living on serial + buzzer", "steps": [{ "inject_fault": "oled1", "kind": "disconnect" }, { "expect_serial": "ERROR: OLED not found", "within_ms": 500 }, { "expect_serial": "PET born", "within_ms": 500 }, { "hold_ms": 100, "press": "btnFeed" }, { "expect_serial": "EVENT feed: hunger=", "within_ms": 300 }, { "expect_serial": "BEEP need=food", "within_ms": 40000 }] }
  ]
}
